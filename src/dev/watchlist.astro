---
// The list's kitchen sink: the header, the list's head, rows, chips, search results and footer in every state the list
// can show, and a list long enough to scroll, built by the list's own components and row service from the fixtures in
// watchlist-fixtures.ts, for review and screenshots. Only `astro dev` serves it (astro.config.mjs). The page is pinned
// to the light theme and draws every section twice: in the light theme, then in a `dark` wrapper, whose class switches
// the tokens for all it holds. The header's two copies stack at full width, as it spans the screen; the other
// sections' copies stand side by side on a wide screen, as wide as the list's column. Nothing it draws reaches
// Supabase or a shop by a stray tap: the chips and the spelling hint link back here, the rows to products no one has,
// whose pages answer 404 before any lookup, and "Dodaj" to a product the add form refuses; the list's "Odśwież ceny",
// which would refresh the viewer's own list, is drawn inert. A selected row's tag hydrates from lg (1024 px), as the
// island it is beside a product's page, and listens for that product's prices, which no island here sends. Tailwind
// doesn't scan this folder (global.css), so its markup uses only classes the app itself uses, and the columns' widths
// are inline styles.
import AccountMenu from "@/components/shell/AccountMenu.astro";
import AppHeader from "@/components/shell/AppHeader.astro";
import SearchForm from "@/components/shell/SearchForm.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import FilterChips from "@/components/watchlist/FilterChips.astro";
import ListFooter from "@/components/watchlist/ListFooter.astro";
import ListHead from "@/components/watchlist/ListHead.astro";
import ListRows from "@/components/watchlist/ListRows.astro";
import SearchResults from "@/components/watchlist/SearchResults.astro";
import WatchlistRow from "@/components/watchlist/WatchlistRow.astro";
import {
  BESIDE_ID,
  EMAIL,
  GALLERY_COUNTS,
  GALLERY_ROWS,
  HERE,
  LONG_COUNTS,
  LONG_ROWS,
  QUIET_COUNTS,
  ROW_FIXTURES,
  ROWS_FIXTURES,
  SEARCH_CANDIDATES,
  SEARCH_LISTED,
} from "@/dev/watchlist-fixtures";
import Layout from "@/layouts/Layout.astro";
import type { PriceRefreshCode } from "@/lib/services/price-refresh";
import { removedNotice } from "@/lib/services/watchlist";
import { LIST_FILTERS, type ListFilter } from "@/lib/services/watchlist-rows";
import { DARK_THEME, LIGHT_THEME } from "@/lib/theme";

// Each section's two copies: the page's own light theme, then the dark one in a wrapper that also paints its paper and
// sets its text colour, which would otherwise come down from the light page.
const COPIES = [
  { theme: LIGHT_THEME, label: "Jasny motyw", wrapper: "" },
  { theme: DARK_THEME, label: "Ciemny motyw", wrapper: "dark bg-paper text-foreground" },
] as const;
// A column of text, or a section's copy in one theme: 32rem, so the two copies stand side by side on a wide screen.
const COLUMN_STYLE = "max-width: 32rem";
// The list's column beside a product, 420 px wide, as WatchlistShell draws it.
const ASIDE_STYLE = "max-width: 420px";

/**
 * The list's head in its states: each chip on, each refresh notice, the empty list, a failed read, and what a removal
 * from a product's page came to, which the page shows in the head's default slot.
 */
const HEADS: {
  code: string;
  text: string;
  count: number | null;
  filter: ListFilter;
  counts: Record<ListFilter, number> | null;
  refreshCode: PriceRefreshCode | null;
  notice: string | null;
}[] = [
  {
    code: "all",
    text: "cała lista, z wyszukiwarką telefonu",
    count: GALLERY_ROWS.length,
    filter: "all",
    counts: GALLERY_COUNTS,
    refreshCode: null,
    notice: null,
  },
  {
    code: "promo + partial",
    text: "Promocje, po częściowym odświeżeniu",
    count: GALLERY_ROWS.length,
    filter: "promo",
    counts: GALLERY_COUNTS,
    refreshCode: "partial",
    notice: null,
  },
  {
    code: "check + done",
    text: "Do sprawdzenia, po odświeżeniu",
    count: GALLERY_ROWS.length,
    filter: "check",
    counts: GALLERY_COUNTS,
    refreshCode: "done",
    notice: null,
  },
  {
    code: "empty + none",
    text: "pusta lista: bez licznika, odświeżania i filtrów",
    count: 0,
    filter: "all",
    counts: null,
    refreshCode: "none",
    notice: null,
  },
  {
    code: "read-failed + failed",
    text: "nie udało się wczytać cen: bez filtrów",
    count: 3,
    filter: "all",
    counts: null,
    refreshCode: "failed",
    notice: null,
  },
  {
    code: "check + removed",
    text: "po usunięciu produktu z jego strony (?removed=done), z filtrem, który usunięcie zachowuje",
    count: GALLERY_ROWS.length,
    filter: "check",
    counts: GALLERY_COUNTS,
    refreshCode: null,
    notice: removedNotice("done"),
  },
  {
    code: "removed + gone",
    text: "usunięcie produktu, którego już nie było na liście, na przykład wysłane drugi raz (?removed=gone)",
    count: GALLERY_ROWS.length,
    filter: "all",
    counts: GALLERY_COUNTS,
    refreshCode: null,
    notice: removedNotice("gone"),
  },
];
---

<Layout title="Kitchen sink: lista · Drogeria Radar" lang="pl" theme="light">
  <div class="bg-paper min-h-screen p-4 text-foreground sm:p-8">
    <main class="flex flex-col gap-6">
      <header class="flex flex-col gap-3" style={COLUMN_STYLE}>
        <h1 class="text-2xl font-bold">Kitchen sink: lista</h1>
        <p class="text-sm text-muted-foreground">
          Widok <code>/watchlist</code> w każdym stanie, jaki może pokazać, na danych z{" "}
          <code>src/dev/watchlist-fixtures.ts</code>, zbudowanych serwisem wierszy listy. Każda sekcja jest dwa razy: w
          jasnym motywie i w ciemnym. Ta strona istnieje tylko w <code>astro dev</code>.
        </p>
        <p class="text-sm text-muted-foreground">
          Filtry i podpowiedź pisowni prowadzą tutaj, wiersze do produktów, których nie ma na niczyjej liście, a „Dodaj”
          do produktu, którego formularz nie przyjmie, więc przypadkowe kliknięcie nie wysyła zapytania do żadnego
          sklepu. „Odśwież ceny” w nagłówku listy odświeżyłoby Twoją listę, więc jest nieaktywne. „Wyloguj” wylogowuje
          naprawdę. <code>:hover</code> i <code>focus-visible</code> trzeba sprawdzić w DevTools i klawiaturą.
        </p>
      </header>

      <section aria-labelledby="header-heading" class="flex flex-col gap-3">
        <h2 id="header-heading" class="text-lg font-semibold">
          Nagłówek
        </h2>
        <p class="text-sm text-muted-foreground" style={COLUMN_STYLE}>
          <code>AppHeader</code> ekranu listy: od 1024 px wersja na komputer, z adresem e-mail od 1280 px, poniżej
          wersja na telefon. Pod nim <code>AccountMenu</code> z telefonu, otwarte, w każdej szerokości.
        </p>
        {COPIES.map(({ theme, label, wrapper }) => (
          <div class:list={["flex flex-col gap-3 rounded-card p-4", wrapper]}>
            <p class="text-sm font-semibold">{label}</p>
            <div class="bg-paper">
              <AppHeader mode="list" email={EMAIL} query={null} idPrefix={`${theme}-`} />
            </div>
            <p class="text-xs text-muted-foreground">
              <code>AccountMenu</code>, otwarte
            </p>
            {/* The open menu's panel hangs below the avatar, out of the flow, so its box leaves room for it. */}
            <div class="flex items-start" style="min-height: 13rem">
              <div class="ml-auto">
                <AccountMenu email={EMAIL} open />
              </div>
            </div>
          </div>
        ))}
      </section>

      <div class="flex flex-wrap items-start gap-6">
        {COPIES.map(({ theme, label, wrapper }) => (
          <div class:list={["flex w-full flex-col gap-6 rounded-card p-4", wrapper]} style={COLUMN_STYLE}>
            <p class="text-sm font-semibold">{label}</p>

            <section aria-labelledby={`${theme}-rows-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-rows-heading`} class="text-lg font-semibold">
                Wiersz
              </h2>
              <p class="text-sm text-muted-foreground">
                <code>WatchlistRow</code> w każdym stanie etykiety ceny (<code>priceTagOf</code>), ze sklepem i wiekiem
                ceny pod etykietą, wybrany i z długą nazwą. Czytnik ekranu słyszy zamiast etykiety i tej linii cały
                wiersz (<code>summary</code>). Automatyczne dopasowanie w Naturze, które różni się od produktu rozmiarem
                lub marką, wygląda jak inne, ale liczy się w „Do sprawdzenia”, a linia czytnika mówi dlaczego: wiersz
                <code>suspicious</code>.
              </p>
              <div class="flex flex-col gap-6">
                {ROW_FIXTURES.map(({ code, text, row, selected }) => (
                  <div class="flex flex-col gap-1">
                    <p class="text-xs text-muted-foreground">
                      <code>{code}</code> · {text}
                    </p>
                    <WatchlistRow row={row} filter="all" selected={selected} />
                  </div>
                ))}
              </div>
            </section>

            <section aria-labelledby={`${theme}-chips-heading`} class="flex flex-col gap-3" data-show-hit-areas>
              <h2 id={`${theme}-chips-heading`} class="text-lg font-semibold">
                Filtry
              </h2>
              <p class="text-sm text-muted-foreground">
                <code>FilterChips</code> z każdym filtrem włączonym, z licznikami całej listy powyżej, i z filtrami bez
                produktów. Kreska obrysowuje strefę dotyku 44 × 44 px.
              </p>
              <div class="flex flex-col gap-6">
                {LIST_FILTERS.map((filter) => (
                  <div class="flex flex-col gap-1">
                    <p class="text-xs text-muted-foreground">
                      <code>{filter}</code>
                    </p>
                    <FilterChips path={HERE} active={filter} counts={GALLERY_COUNTS} />
                  </div>
                ))}
                <div class="flex flex-col gap-1">
                  <p class="text-xs text-muted-foreground">
                    <code>all, 0</code> · nic w promocji i nic do sprawdzenia
                  </p>
                  <FilterChips path={HERE} active="all" counts={QUIET_COUNTS} />
                </div>
              </div>
            </section>

            <section aria-labelledby={`${theme}-head-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-head-heading`} class="text-lg font-semibold">
                Góra listy
              </h2>
              <p class="text-sm text-muted-foreground">
                <code>ListHead</code>: tytuł z licznikiem, „Odśwież ceny”, komunikat odświeżenia, komunikat po usunięciu
                produktu, wyszukiwarka telefonu (poniżej 1024 px) i filtry.
              </p>
              <div class="flex flex-col gap-6">
                {HEADS.map(({ code, text, count, filter, counts, refreshCode, notice }, index) => (
                  <div class="flex flex-col gap-1">
                    <p class="text-xs text-muted-foreground">
                      <code>{code}</code> · {text}
                    </p>
                    <div inert>
                      <ListHead count={count} path={HERE} filter={filter} counts={counts} refreshCode={refreshCode}>
                        {/* As the list shows a notice: a status Alert in the head's default slot. */}
                        {notice && (
                          <Alert variant="success" role="status">
                            <AlertDescription>{notice}</AlertDescription>
                          </Alert>
                        )}
                        {index === 0 && (
                          <SearchForm
                            slot="search"
                            id={`${theme}-q-mobile`}
                            value={null}
                            variant="list"
                            class="lg:hidden"
                          />
                        )}
                      </ListHead>
                    </div>
                  </div>
                ))}
              </div>
            </section>

            <section aria-labelledby={`${theme}-list-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-list-heading`} class="text-lg font-semibold">
                Wiersze listy
              </h2>
              <p class="text-sm text-muted-foreground">
                <code>ListRows</code>: pusta lista, nieudane odczyty i filtr bez produktów, z wierszami zbudowanymi z
                odczytów listy (<code>listRowsOf</code>).
              </p>
              <div class="flex flex-col gap-6">
                {ROWS_FIXTURES.map(({ code, text, rows, filter, matchesFailed, pricesFailed }) => (
                  <div class="flex flex-col gap-1">
                    <p class="text-xs text-muted-foreground">
                      <code>{code}</code> · {text}
                    </p>
                    <ListRows rows={rows} filter={filter} matchesFailed={matchesFailed} pricesFailed={pricesFailed} />
                  </div>
                ))}
              </div>
            </section>

            <section aria-labelledby={`${theme}-beside-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-beside-heading`} class="text-lg font-semibold">
                Obok produktu
              </h2>
              <p class="text-sm text-muted-foreground">
                Lista w lewej kolumnie strony produktu od 1024 px: <code>ListHead</code> z nagłówkiem drugiego poziomu,
                po odświeżeniu, z „Odśwież ceny”, które wraca do produktu (<code>back</code>); filtry; wiersze z
                wybranym produktem, którego etykieta jest od 1024 px wyspą i nasłuchuje odświeżenia produktu (
                <code>PRICES_EVENT</code>), tu bez żadnego; i stopka. Kolumna ma 420 px, jak na stronie.
              </p>
              {/* The shell's aside, as WatchlistShell pads it: its head, its rows and its footer. */}
              <div class="flex flex-col rounded-card border-hairline" style={ASIDE_STYLE}>
                <div class="flex flex-col px-4.5 pt-5.5 lg:px-7 lg:pt-7 lg:pb-4" inert>
                  <ListHead
                    level={2}
                    count={GALLERY_ROWS.length}
                    path={HERE}
                    filter="all"
                    counts={GALLERY_COUNTS}
                    refreshCode="done"
                    back={BESIDE_ID}
                  />
                </div>
                <div class="px-4.5 pt-3.5 pb-2 lg:px-7 lg:pt-2.5 lg:pb-4.5">
                  <ListRows
                    rows={GALLERY_ROWS}
                    filter="all"
                    matchesFailed={false}
                    pricesFailed={false}
                    selectedId={BESIDE_ID}
                  />
                </div>
                <div class="px-5 pt-1.5 pb-6 lg:border-t-hairline lg:px-7 lg:py-3.5">
                  <ListFooter />
                </div>
              </div>
            </section>

            <section aria-labelledby={`${theme}-scroll-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-scroll-heading`} class="text-lg font-semibold">
                Przewijanie
              </h2>
              <p class="text-sm text-muted-foreground">
                Ta sama kolumna z {LONG_ROWS.length} produktami. Od 1024 px ma wysokość okna, jak na stronie, a jej
                wiersze przewijają się same między górą listy a stopką; wybrany produkt stoi na dole, więc jego
                uniesienie i obrys fokusu widać po przewinięciu do niego, a wiersz, do którego przewija klawiatura
                (Tab), zostaje 12 px od krawędzi, z całym obrysem. Na telefonie przewija się cała strona.
              </p>
              {/* The shell's aside, with WatchlistShell's classes for its parts and the screen's height from lg. */}
              <div class="flex flex-col rounded-card border-hairline lg:h-dvh" style={ASIDE_STYLE}>
                <div class="flex flex-col px-4.5 pt-5.5 lg:px-7 lg:pt-7 lg:pb-4" inert>
                  <ListHead
                    level={2}
                    count={LONG_ROWS.length}
                    path={HERE}
                    filter="all"
                    counts={LONG_COUNTS}
                    refreshCode={null}
                    back={BESIDE_ID}
                  />
                </div>
                <div class="px-4.5 pt-3.5 pb-2 lg:min-h-0 lg:flex-1 lg:scroll-py-3 lg:overflow-y-auto lg:px-7 lg:pt-2.5 lg:pb-4.5">
                  <ListRows
                    rows={LONG_ROWS}
                    filter="all"
                    matchesFailed={false}
                    pricesFailed={false}
                    selectedId={BESIDE_ID}
                  />
                </div>
                <div class="px-5 pt-1.5 pb-6 lg:border-t-hairline lg:px-7 lg:py-3.5">
                  <ListFooter />
                </div>
              </div>
            </section>

            <section aria-labelledby={`${theme}-search-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-search-heading`} class="text-lg font-semibold">
                Wyszukiwanie
              </h2>
              <p class="text-sm text-muted-foreground">
                <code>SearchResults</code>: „Dodaj” i „Na liście”, z podpowiedzią pisowni, i wyszukiwanie bez wyników.
              </p>
              <div class="flex flex-col gap-6">
                <SearchResults
                  query="nivea soft"
                  candidates={SEARCH_CANDIDATES}
                  spellingHint="nivea soft 300 ml"
                  listed={SEARCH_LISTED}
                  path={HERE}
                  idPrefix={`${theme}-results-`}
                />
                <SearchResults
                  query="nivea sofft"
                  candidates={[]}
                  spellingHint={null}
                  listed={SEARCH_LISTED}
                  path={HERE}
                  idPrefix={`${theme}-no-results-`}
                />
              </div>
            </section>

            <section aria-labelledby={`${theme}-footer-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-footer-heading`} class="text-lg font-semibold">
                Stopka
              </h2>
              <ListFooter />
            </section>
          </div>
        ))}
      </div>
    </main>
  </div>
</Layout>
