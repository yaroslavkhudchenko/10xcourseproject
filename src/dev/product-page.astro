---
// The product page's kitchen sink: the view in every state it can show, and the pieces it's built from in each variant,
// from the fixtures in fixtures.ts, for review and screenshots. Only `astro dev` serves it (astro.config.mjs). The page
// is pinned to the light theme, and draws every section twice: in the light theme, then in a `dark` wrapper, whose
// class switches the tokens for all it holds. The product area's states, every price state with Natura in every kind,
// and Natura's in the shops' cards, stand in frames as wide as the product's pane beside the list at 1280 px (860 px),
// each frame the containing block of its phone's bottom bar, which it otherwise fixes to the screen. The view lays
// itself out by the screen's width, not the frame's, so from 1024 to 1279 px the frames show the layout the narrower
// pane gets there. The other sections' copies stand side by side on a wide screen. It hydrates nothing, so no island
// effect runs, and nothing it calls reaches Supabase or a shop; its only scripts are the forms' SubmitOnce, for the
// Natura choice and the removal, and the theme switch's. Tailwind doesn't scan this folder (global.css), so its markup
// uses only classes the app itself uses, and the frames' and columns' widths and the frames' containing block are
// inline styles.
import { RefreshCw } from "lucide-react";
import LogoMark from "@/components/shell/LogoMark.astro";
import ThemeToggle from "@/components/shell/ThemeToggle.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { matchCardOf } from "@/components/watchlist/match-card";
import MatchChoice from "@/components/watchlist/MatchChoice.astro";
import Price from "@/components/watchlist/Price";
import { comparisonOf } from "@/components/watchlist/price-comparison-state";
import PriceComparisonView, { ShopGrid } from "@/components/watchlist/PriceComparisonView";
import ProductThumb from "@/components/watchlist/ProductThumb";
import ProductUnavailable from "@/components/watchlist/ProductUnavailable.astro";
import RemoveProduct from "@/components/watchlist/RemoveProduct.astro";
import Sticker from "@/components/watchlist/Sticker";
import {
  ALONE_FIXTURES,
  GONE_ERROR,
  HANDOFF_FIXTURES,
  HERE,
  NATURA_FIXTURES,
  PRICE_FIXTURES,
  PRICE_SAMPLES,
  PRODUCT_ID,
  REMOVAL_GONE_NOTICE,
  REMOVE_FIXTURES,
  THUMB_FIXTURES,
} from "@/dev/fixtures";
import Layout from "@/layouts/Layout.astro";
import { DARK_THEME, LIGHT_THEME } from "@/lib/theme";
import { cn } from "@/lib/utils";

// Each section's two copies: the page's own light theme, then the dark one in a wrapper that also paints its paper and
// sets its text colour, which would otherwise come down from the light page.
const COPIES = [
  { theme: LIGHT_THEME, label: "Jasny motyw", wrapper: "" },
  { theme: DARK_THEME, label: "Ciemny motyw", wrapper: "dark bg-paper text-foreground" },
] as const;

// Every state of the product area, in three groups: with Natura's price, which a saved match brings; with Rossmann's
// price alone, beside each other kind of Natura; and the handoff's samples.
const AREA_GROUPS = [
  { id: "area-matched", heading: "Z ceną Natury: zapisane dopasowanie", fixtures: PRICE_FIXTURES },
  { id: "area-alone", heading: "Sama cena Rossmanna: Natura w każdym innym rodzaju", fixtures: ALONE_FIXTURES },
  { id: "area-handoff", heading: "Próbki z projektu", fixtures: HANDOFF_FIXTURES },
];
// A column of text, or a section's copy in one theme: 32rem, so the two copies stand side by side on a wide screen.
const COLUMN_STYLE = "max-width: 32rem";
// A frame stands for the product's pane: its paddings are the pane's, with room below for a phone's bottom bar, and it
// clips what spills sideways, as the pane does. Its transform makes it the bar's containing block.
const FRAME =
  "w-full overflow-x-clip rounded-card bg-paper px-4.5 pt-2 pb-28 text-foreground lg:px-11 lg:pt-7.5 lg:pb-10";
const FRAME_STYLE = "max-width: 860px; transform: translateZ(0)";
// Natura's states stand in the same pane without a bottom bar: the shops' cards, with the choice below them.
const CARDS_FRAME =
  "w-full overflow-x-clip rounded-card bg-paper px-4.5 pt-5.5 pb-6 text-foreground lg:px-11 lg:pt-7.5 lg:pb-10";

const PRICE_SIZES = ["hero", "card", "tag"] as const;

const STICKERS = [
  { kind: "one-shop", size: "lg" },
  { kind: "one-shop", size: "sm" },
  { kind: "stale", size: "lg" },
  { kind: "stale", size: "sm" },
] as const;

const BADGES = [
  { variant: "default", text: "Na liście" },
  { variant: "secondary", text: "Rossmann" },
  { variant: "destructive", text: "Nie znaleziono" },
  { variant: "outline", text: "Drogerie Natura" },
  { variant: "ghost", text: "rossmann.pl" },
  { variant: "link", text: "Zobacz w sklepie" },
  { variant: "success", text: "Najtaniej" },
  { variant: "warning", text: "nieaktualna" },
  { variant: "promo", text: "promocja do 05.10" },
  { variant: "tag-sun", text: "Najtaniej" },
  { variant: "tag-warn", text: "Nieaktualna" },
] as const;

const BUTTONS = [
  { variant: "default", text: "To ten produkt" },
  { variant: "destructive", text: "Wyloguj" },
  { variant: "outline", text: "Żaden z nich" },
  { variant: "secondary", text: "Szukaj" },
  { variant: "ghost", text: "Moja lista" },
  { variant: "link", text: "← Moja lista" },
  { variant: "underlined", text: "Pokaż zapisaną decyzję" },
] as const;

// The registry's sizes, which no view uses: each draws below 44 px, with a 44 px hit area around it (hit-area).
const REGISTRY_SIZES = ["default", "sm", "lg"] as const;

const LINK_BUTTONS = [
  { variant: "default", text: "Dopasuj w Naturze" },
  { variant: "outline", text: "Szukaj ponownie" },
  { variant: "link", text: "← Moja lista" },
  { variant: "underlined", text: "Zobacz w sklepie" },
] as const;
---

<Layout title="Kitchen sink · Drogeria Radar" lang="pl" theme="light">
  {/* The product page's own canvas; each copy below is as wide as its column. */}
  <div class="bg-paper min-h-screen p-4 text-foreground sm:p-8">
    <main class="flex flex-col gap-6">
      <header class="flex flex-col gap-3" style={COLUMN_STYLE}>
        <h1 class="text-2xl font-bold">Kitchen sink: strona produktu</h1>
        <p class="text-sm text-muted-foreground">
          Widok <code>/watchlist/[id]</code> w każdym stanie, jaki może pokazać, i elementy, z których jest zbudowany, w
          każdym wariancie, na danych z <code>src/dev/fixtures.ts</code>. Każda sekcja jest dwa razy: w jasnym motywie i
          w ciemnym. Obszar produktu stoi w ramkach szerokości prawej kolumny strony przy 1280 px (860 px); poniżej 1024
          px każda ramka ma na dole swój pasek „Odśwież ceny”. Ta strona istnieje tylko w <code>astro dev</code>.
        </p>
        <p class="text-sm text-muted-foreground">
          Formularze i linki prowadzą do zmyślonego produktu, którego nie ma na niczyjej liście, więc przypadkowe
          kliknięcie nie wysyła zapytania do żadnego sklepu.
        </p>
      </header>

      <section aria-labelledby="legend-heading" class="flex flex-col gap-3" style={COLUMN_STYLE}>
        <h2 id="legend-heading" class="text-lg font-semibold">
          Macierz 7 stanów
        </h2>
        <p class="text-sm text-muted-foreground">
          Gdzie niżej widać każdy stan kontrolek widoku, jako <em>sekcja › etykieta</em>. Stan, którego statyczna strona
          nie pokaże, ma podany powód.
        </p>
        <dl class="flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>default</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              Każdy stan poniżej: tylko tokeny i komponenty z <code>src/components/ui</code>. Warianty samych
              komponentów: sekcje od Price do Button w każdej kolumnie. Zapisane dopasowanie Natury nazywa w stopce
              karty swoją pozycję, markę i rozmiar nad nazwą, z „Zmień”: Natura › <code>matched</code>. Jego
              ostrzeżenia, po jednym na inny rozmiar i inną markę: Natura › <code>matched + notice</code> i{" "}
              <code>matched + brand</code>. Flaga „Inna marka” przy kandydacie: Natura › <code>choose + error</code>.
              Odrzucona Natura z „Dopasuj ponownie”: Natura › <code>unmatched</code>. Wybór, który zmienia zapisaną
              decyzję, z obecnym dopasowaniem oznaczonym, a automatycznym także z „To ten produkt”, i kartą z „Anuluj”:
              Natura › <code>matched + repin</code>, z dopasowaniem potwierdzonym przez Ciebie, tylko oznaczonym: Natura
              › <code>confirmed + repin</code>, a dla odrzuconej Natury, bez „Żaden z nich”: Natura ›{" "}
              <code>unmatched + repin</code>. „Usuń z listy” na dole strony, zamknięte i otwarte: Usuń z listy ›{" "}
              <code>closed</code> i <code>open</code>.
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>hover</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              N/A w statycznym widoku: <code>:hover</code> trzeba wymusić w DevTools, raz dla każdego typu kontrolki. To
              przyciski <code>default</code> („Odśwież ceny” w wierszu tytułu i na dolnym pasku, „To ten produkt”) i{" "}
              <code>outline</code> („Żaden z nich”), linki w stylu przycisku („Dopasuj w Naturze”, „Szukaj ponownie”,
              „Zobacz w sklepie”, „Pokaż zapisaną decyzję”, „Zmień”, „Dopasuj ponownie” i oba „Anuluj”, Natura ›{" "}
              <code>matched + repin</code>), linki w alertach („Zaloguj się ponownie”, Obszar produktu ›{" "}
              <code>session-ended</code>, i „Odśwież stronę”, Obszar produktu › <code>match-changed</code>), przełącznik
              motywu, a w „Usuń z listy” podsumowanie w stylu przycisku <code>outline</code> i przycisk{" "}
              <code>destructive</code> (Usuń z listy › <code>open</code>).
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>focus-visible</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              N/A w statycznym widoku: wymaga przejścia klawiaturą (Tab) przez te same kontrolki. Każda ma pokazać obrys
              2 px w kolorze <code>--ring</code>, 2 px od krawędzi, w obu motywach.
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>disabled</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              Oba „Odśwież ceny”, w wierszu tytułu (od 1024 px) i na dolnym pasku (poniżej): Obszar produktu ›{" "}
              <code>refreshing</code> i <code>read-failed-one-answered</code>. Przycisk decyzji po wysłaniu wyłącza
              dopiero skrypt SubmitOnce, po kliknięciu, więc pokazuje go wyłączony Button zaraz pod Natura ›{" "}
              <code>choose + error</code>, a czerwone „Usuń z listy” po wysłaniu: Usuń z listy ›{" "}
              <code>open, po wysłaniu</code>.
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>error</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              Destrukcyjny Alert w karcie Natury: Natura › <code>choose + error</code>. „Nie udało się wczytać cen” w
              hero i „Nie udało się wczytać ceny.” na karcie sklepu: Obszar produktu › <code>read-failed</code>,{" "}
              <code>read-failed-one-answered</code> i <code>read-failed-one-shop</code>, a przy nieodczytanej decyzji
              Natury Obszar produktu › <code>natura-read-failed</code>. Komunikaty kart: Obszar produktu ›{" "}
              <code>notice-busy-paused</code> i <code>notice-stopped-failed</code>. Do tego Natura ›{" "}
              <code>read-failed</code> i Gałęzie strony › <code>not-found + error</code>. Wybór, który zmienia decyzję,
              przy zablokowanej Naturze i bez wyszukiwania po nazwie: Natura › <code>repin + unavailable</code> i{" "}
              <code>repin + incomplete</code>. Destrukcyjny Alert w otwartym potwierdzeniu po nieudanym usunięciu: Usuń
              z listy › <code>failed</code>.
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>empty</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              „Jeszcze bez ceny”: Obszar produktu › <code>never-checked</code>. Odrzucona decyzja: Natura ›{" "}
              <code>unmatched</code>. Nieznaleziony produkt: Gałęzie strony › <code>not-found</code>, a po usunięciu,
              które mimo braku odpowiedzi się udało: <code>not-found + removal</code>. Wybór, w którym nic nie
              znaleziono: Natura › <code>repin + not found</code>.
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-sm font-semibold">
              <code>loading</code>
            </dt>
            <dd class="text-sm text-muted-foreground">
              „Odświeżam…” przy nazwie sklepu i cyfry ceny w 60 %: Obszar produktu › <code>refreshing</code>, przy tych
              samych cenach co <code>cheapest</code>. Porównaj oba: poza napisem przy nazwie nic nie może się przesunąć.
            </dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="area-heading" class="flex flex-col gap-3">
        <h2 id="area-heading" class="text-lg font-semibold">
          Obszar produktu
        </h2>
        <p class="text-sm text-muted-foreground" style={COLUMN_STYLE}>
          <code>PriceComparisonView</code> bez wyspy, w stanach zbudowanych jej reducerem: tytuł z „Odśwież ceny”, hero
          z naklejką, pasek cen albo jego podpowiedź, karty sklepów z kartą Natury i, poniżej 1024 px, dolny pasek. Bez{" "}
          <code>onRefresh</code> oba „Odśwież ceny” wysyłają formularz, jak bez JavaScriptu. Każdy stan jest dwa razy: w
          jasnym motywie i w ciemnym.
        </p>
        <p class="text-sm text-muted-foreground" style={COLUMN_STYLE}>
          Każdy stan ceny z Naturą w każdym rodzaju. Cenę Natury daje tylko zapisane dopasowanie, więc stany z nią stoją
          w pierwszej grupie; bez niego Natura nie ma wiersza ceny, więc w drugiej grupie stoi sama cena Rossmanna, w
          każdym stanie, obok każdego innego rodzaju Natury. Hero i pasek rozróżniają te rodzaje tylko jako: czeka na
          dopasowanie (<code>prompt</code>, <code>choose</code>, <code>unavailable</code>), zdecydowana (
          <code>unmatched</code>, <code>not-found</code>, <code>decided</code>, niezapisane dopasowanie) i nieodczytana
          (<code>read-failed</code>), a kartę Natury w każdym rodzaju pokazuje sekcja Natura. Na końcu próbki z
          projektu.
        </p>
        <p class="text-sm text-muted-foreground" style={COLUMN_STYLE}>
          Układ zależy od szerokości okna, nie ramki: od 1280 px jak w projekcie, z ceną obok tekstu w hero i kartami w
          dwóch kolumnach; od 1024 do 1279 px, gdzie prawa kolumna strony ma 604–859 px, tytuł i jego kafelek mają
          rozmiar z telefonu, hero układa się w kolumnę, a karty stoją jedna pod drugą.
        </p>
        <div class="flex flex-col gap-6">
          {AREA_GROUPS.map(({ id, heading, fixtures }) => (
            <section aria-labelledby={id} class="flex flex-col gap-6">
              <h3 id={id} class="text-base font-semibold">
                {heading}
              </h3>
              {fixtures.map(({ code, text, state, product, matched, choice }) => (
                <div class="flex flex-col gap-1">
                  <p class="text-xs text-muted-foreground">
                    <code>{code}</code> · {text}
                  </p>
                  <div class="flex flex-wrap items-start gap-6">
                    {COPIES.map(({ theme, wrapper }) => (
                      <div class:list={[FRAME, wrapper]} style={FRAME_STYLE}>
                        {/* As the page stands them: the island, then the choice of Natura's candidates below it. */}
                        <div class="flex flex-col gap-6 lg:gap-6.5">
                          <PriceComparisonView
                            itemId={PRODUCT_ID}
                            listFilter="all"
                            product={product}
                            state={state}
                            matched={matched}
                          />
                          {choice && (
                            <MatchChoice
                              shop="natura"
                              view={choice}
                              productId={PRODUCT_ID}
                              filter="all"
                              idPrefix={`${theme}-area-${code}`}
                            />
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </section>
          ))}
        </div>
      </section>

      <section aria-labelledby="natura-heading" class="flex flex-col gap-3">
        <h2 id="natura-heading" class="text-lg font-semibold">
          Natura
        </h2>
        <p class="text-sm text-muted-foreground" style={COLUMN_STYLE}>
          Karta Natury wśród kart sklepów (<code>ShopGrid</code>, <code>matchCardOf</code>) w każdym rodzaju widoku, z
          komunikatem o zapisie, błędem zapisu i niezapisanym wynikiem wyszukiwania, obok ceny Rossmanna. Przy wyborze
          kandydatów pod kartami stoi sekcja wyboru (<code>MatchChoice</code>), także przy wyborze, który zmienia
          zapisaną decyzję („Zmień”, „Dopasuj ponownie”), w każdym wyniku jego wyszukiwań. Każdy stan jest dwa razy: w
          jasnym motywie i w ciemnym.
        </p>
        <div class="flex flex-col gap-6">
          {NATURA_FIXTURES.map(({ code, text, idPrefix, natura, state, repin }) => (
            <div class="flex flex-col gap-1">
              <p class="text-xs text-muted-foreground">
                <code>{code}</code> · {text}
              </p>
              <div class="flex flex-wrap items-start gap-6">
                {COPIES.map(({ theme, wrapper }) => (
                  <div class:list={[CARDS_FRAME, wrapper]} style={FRAME_STYLE}>
                    <div class="flex flex-col gap-6 lg:gap-6.5">
                      <ShopGrid rows={comparisonOf(state).rows} now={state.now} cards={[matchCardOf(natura)]} />
                      {/* The choice that changes a stored decision, below the cards, as the page stands it. */}
                      {repin && (
                        <MatchChoice
                          shop="natura"
                          view={repin}
                          productId={PRODUCT_ID}
                          filter="all"
                          idPrefix={`${theme}-${idPrefix}`}
                        />
                      )}
                      {natura.view.kind === "choose" && (
                        <>
                          <MatchChoice
                            shop="natura"
                            view={natura.view}
                            productId={PRODUCT_ID}
                            filter="all"
                            idPrefix={`${theme}-${idPrefix}`}
                          />
                          {/* A decision's buttons once one is sent: SubmitOnce disables every one of them. */}
                          <div class="flex flex-col gap-1">
                            <p class="text-xs text-muted-foreground">
                              <code>{code}</code>, po wysłaniu · SubmitOnce wyłącza przyciski wszystkich formularzy
                              decyzji
                            </p>
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                              <Button type="button" size="touch" disabled>
                                To ten produkt
                              </Button>
                            </div>
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="remove-heading" class="flex flex-col gap-3">
        <h2 id="remove-heading" class="text-lg font-semibold">
          Usuń z listy
        </h2>
        <p class="text-sm text-muted-foreground" style={COLUMN_STYLE}>
          <code>RemoveProduct</code> na dole strony produktu, pod kartami sklepów i wyborem Natury, w każdej szerokości:
          zamknięte, otwarte i po nieudanym usunięciu. Otwiera się bez JavaScriptu. Formularz usuwa zmyślony produkt,
          którego nie ma na niczyjej liście, więc przypadkowe kliknięcie niczego nie usuwa. Każdy stan jest dwa razy: w
          jasnym motywie i w ciemnym.
        </p>
        <div class="flex flex-col gap-6">
          {REMOVE_FIXTURES.map(({ code, text, open, error }) => (
            <div class="flex flex-col gap-1">
              <p class="text-xs text-muted-foreground">
                <code>{code}</code> · {text}
              </p>
              <div class="flex flex-wrap items-start gap-6">
                {COPIES.map(({ theme, wrapper }) => (
                  <div class:list={[CARDS_FRAME, wrapper]} style={FRAME_STYLE}>
                    <RemoveProduct
                      productId={PRODUCT_ID}
                      filter="all"
                      open={open}
                      error={error}
                      idPrefix={`${theme}-remove-${code}`}
                    />
                  </div>
                ))}
              </div>
            </div>
          ))}
          {/* The removal's button once it's sent: SubmitOnce disables it. */}
          <div class="flex flex-col gap-1">
            <p class="text-xs text-muted-foreground">
              <code>open, po wysłaniu</code> · SubmitOnce wyłącza czerwone „Usuń z listy”
            </p>
            <div class="flex flex-wrap items-start gap-6">
              {COPIES.map(({ wrapper }) => (
                <div class:list={[CARDS_FRAME, wrapper]} style={FRAME_STYLE}>
                  <Button type="button" variant="destructive" size="touch" disabled>
                    Usuń z listy
                  </Button>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <div class="flex flex-wrap items-start gap-6">
        {COPIES.map(({ theme, label, wrapper }) => (
          <div class:list={["flex w-full flex-col gap-6 rounded-card p-4", wrapper]} style={COLUMN_STYLE}>
            <p class="text-sm font-semibold">{label}</p>

            <section aria-labelledby={`${theme}-states-branches-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-states-branches-heading`} class="text-lg font-semibold">
                Gałęzie strony
              </h2>
              <p class="text-sm text-muted-foreground">
                <code>ProductUnavailable</code>, gdy nie ma produktu do pokazania, w odstępach kolumny strony.
              </p>
              <div class="flex flex-col gap-6">
                <div class="flex flex-col gap-1">
                  <p class="text-xs text-muted-foreground">
                    <code>not-found</code> · produktu nie ma na Twojej liście (404)
                  </p>
                  <div class="flex flex-col gap-6">
                    <ProductUnavailable reason="not-found" />
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <p class="text-xs text-muted-foreground">
                    <code>not-found + error</code> · wybór wysłany dla produktu, którego nie ma (
                    <code>?error=gone</code>)
                  </p>
                  <div class="flex flex-col gap-6">
                    <ProductUnavailable reason="not-found" error={GONE_ERROR} />
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <p class="text-xs text-muted-foreground">
                    <code>not-found + removal</code> · usunięcie bez odpowiedzi, które jednak się udało (
                    <code>?removal=failed</code>)
                  </p>
                  <div class="flex flex-col gap-6">
                    <ProductUnavailable reason="not-found" notice={REMOVAL_GONE_NOTICE} />
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <p class="text-xs text-muted-foreground">
                    <code>failed</code> · nie udało się wczytać produktu (503)
                  </p>
                  <div class="flex flex-col gap-6">
                    <ProductUnavailable reason="failed" />
                  </div>
                </div>
              </div>
            </section>

            <section aria-labelledby={`${theme}-price-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-price-heading`} class="text-lg font-semibold">
                Price
              </h2>
              <p class="text-sm text-muted-foreground">
                Cena jak na etykiecie: złote, grosze przy ich górze, podkreślone, i „zł” pod groszami. Czytnik ekranu
                słyszy ją raz, tak jak zapisuje ją <code>formatPrice</code>. Hero i karta są mniejsze poniżej 1024 px.
              </p>
              {PRICE_SIZES.map((size) => (
                <div class="flex flex-col gap-1">
                  <code class="text-xs text-muted-foreground">{size}</code>
                  <div class="flex flex-wrap items-start gap-6">
                    {PRICE_SAMPLES[size].map((amount) => (
                      <Price amount={amount} size={size} />
                    ))}
                  </div>
                </div>
              ))}
              <div class="flex flex-col gap-1">
                <code class="text-xs text-muted-foreground">tag, na etykiecie w kolorze sun</code>
                <div class="flex flex-wrap items-start gap-6">
                  {PRICE_SAMPLES.tag.map((amount) => (
                    <span class="rounded-button-sm bg-sun p-3 text-label-ink">
                      <Price amount={amount} size="tag" />
                    </span>
                  ))}
                </div>
              </div>
            </section>

            <section aria-labelledby={`${theme}-sticker-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-sticker-heading`} class="text-lg font-semibold">
                Sticker
              </h2>
              <p class="text-sm text-muted-foreground">
                Naklejka mówi tylko fakt, do czasu reguły dobrej ceny (FR-012). Przy wczytaniu strony przybija się raz,
                a przy ograniczonym ruchu pojawia się bez animacji.
              </p>
              <div class="flex flex-wrap items-center gap-6 p-4">
                {STICKERS.map(({ kind, size }) => (
                  <div class="flex flex-col items-center gap-3">
                    <Sticker kind={kind} size={size} />
                    <code class="text-xs text-muted-foreground">{`${kind}, ${size}`}</code>
                  </div>
                ))}
              </div>
            </section>

            <section aria-labelledby={`${theme}-logo-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-logo-heading`} class="text-lg font-semibold">
                LogoMark
              </h2>
              <div class="flex flex-col items-start gap-6">
                <div class="flex flex-col gap-1">
                  <code class="text-xs text-muted-foreground">lg · nagłówek na komputerze</code>
                  <LogoMark size="lg" />
                </div>
                <div class="flex flex-col gap-1">
                  <code class="text-xs text-muted-foreground">sm · telefon</code>
                  <LogoMark size="sm" />
                </div>
              </div>
            </section>

            <section aria-labelledby={`${theme}-thumb-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-thumb-heading`} class="text-lg font-semibold">
                ProductThumb
              </h2>
              <p class="text-sm text-muted-foreground">
                Zdjęcie na białym tle albo inicjał marki na jej kafelku (<code>tileOf</code>), w rozmiarze wiersza listy
                i tytułu produktu. Wiersz jest większy od 1024 px, a tytuł od 1280 px.
              </p>
              <ul class="flex flex-col gap-6">
                {THUMB_FIXTURES.map(({ code, text, brand, imageUrl }) => (
                  <li class="flex flex-col items-start gap-3">
                    <p class="text-xs text-muted-foreground">
                      <code>{code}</code> · {text}
                    </p>
                    <div class="flex items-center gap-6">
                      <ProductThumb brand={brand} imageUrl={imageUrl} size="row" />
                      <ProductThumb brand={brand} imageUrl={imageUrl} size="title" />
                    </div>
                  </li>
                ))}
              </ul>
            </section>

            <section aria-labelledby={`${theme}-toggle-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-toggle-heading`} class="text-lg font-semibold">
                ThemeToggle
              </h2>
              <p class="text-sm text-muted-foreground">
                Przełącza motyw całej strony i zapamiętuje wybór. Ta strona zawsze wczytuje się w jasnym motywie, więc
                zapamiętany wybór widać po przeładowaniu stron listy i produktu. Bez JavaScriptu przycisk jest ukryty.
              </p>
              <div class="flex items-center gap-3">
                <ThemeToggle />
              </div>
            </section>

            <section aria-labelledby={`${theme}-card-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-card-heading`} class="text-lg font-semibold">
                Card
              </h2>
              <Card>
                <CardHeader>
                  <CardTitle>Drogerie Natura</CardTitle>
                  <CardDescription>cena online w drogerienatura.pl · 5 min temu</CardDescription>
                  <CardAction>
                    <Badge variant="success">Najtaniej</Badge>
                  </CardAction>
                </CardHeader>
                <CardContent>
                  <Price amount={22.99} size="card" />
                  <p class="text-sm text-muted-foreground">najniższa cena z 30 dni wg sklepu: 23,99 zł</p>
                </CardContent>
                <CardFooter>
                  <a href={HERE} class:list={cn(buttonVariants({ variant: "underlined", size: "touch" }))}>
                    Zobacz w sklepie
                  </a>
                </CardFooter>
              </Card>
            </section>

            <section aria-labelledby={`${theme}-alert-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-alert-heading`} class="text-lg font-semibold">
                Alert
              </h2>
              <div class="flex flex-col gap-1">
                <p class="text-xs text-muted-foreground">
                  <code>default</code>, <code>role="status"</code>
                </p>
                <Alert role="status">
                  <AlertDescription>Nic do odświeżenia: ceny sprawdzono w ciągu ostatnich 15 minut.</AlertDescription>
                </Alert>
              </div>
              <div class="flex flex-col gap-1">
                <p class="text-xs text-muted-foreground">
                  <code>success</code>, <code>role="status"</code>
                </p>
                <Alert variant="success" role="status">
                  <AlertDescription>Zapisano dopasowanie.</AlertDescription>
                </Alert>
              </div>
              <div class="flex flex-col gap-1">
                <p class="text-xs text-muted-foreground">
                  <code>warning</code>, domyślnie <code>role="alert"</code>
                </p>
                <Alert variant="warning">
                  <AlertDescription>
                    Nie wszystkie ceny udało się odświeżyć. Tam, gdzie się nie udało, widać ostatnią znaną cenę i jej
                    wiek.
                  </AlertDescription>
                </Alert>
              </div>
              <div class="flex flex-col gap-1">
                <p class="text-xs text-muted-foreground">
                  <code>destructive</code>, domyślnie <code>role="alert"</code>
                </p>
                <Alert variant="destructive">
                  <AlertDescription>Nie udało się zapisać wyboru. Spróbuj ponownie.</AlertDescription>
                </Alert>
              </div>
            </section>

            <section aria-labelledby={`${theme}-badge-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-badge-heading`} class="text-lg font-semibold">
                Badge
              </h2>
              <ul class="flex flex-col gap-3">
                {BADGES.map(({ variant, text }) => (
                  <li class="flex flex-col items-start gap-1">
                    <code class="text-xs text-muted-foreground">{variant}</code>
                    <Badge variant={variant}>{text}</Badge>
                  </li>
                ))}
              </ul>
            </section>

            <section aria-labelledby={`${theme}-button-heading`} class="flex flex-col gap-3">
              <h2 id={`${theme}-button-heading`} class="text-lg font-semibold">
                Button
              </h2>
              <p class="text-sm text-muted-foreground">
                Każdy wariant w rozmiarze <code>touch</code>, co najmniej 44 px, potem każdy rozmiar. Kreska obrysowuje
                strefę dotyku 44 × 44 px, którą dostają <code>compact</code> i <code>icon</code>, mniejsze na ekranie.
              </p>
              <ul class="flex flex-col gap-4" data-show-hit-areas>
                {BUTTONS.map(({ variant, text }) => (
                  <li class="flex flex-col items-start gap-1">
                    <code class="text-xs text-muted-foreground">{variant}</code>
                    <Button type="button" variant={variant} size="touch">
                      {text}
                    </Button>
                  </li>
                ))}
                <li class="flex flex-col items-start gap-1">
                  <code class="text-xs text-muted-foreground">outline, compact · 38 px</code>
                  <Button type="button" variant="outline" size="compact">
                    Wyloguj
                  </Button>
                </li>
                <li class="flex flex-col items-start gap-1">
                  <code class="text-xs text-muted-foreground">outline, compact z ikoną · 38 px</code>
                  <button type="button" class:list={cn(buttonVariants({ variant: "outline", size: "compact" }))}>
                    <RefreshCw aria-hidden="true" strokeWidth={2.2} className="size-3.75" />
                    Odśwież ceny
                  </button>
                </li>
                <li class="flex flex-col items-start gap-1">
                  <code class="text-xs text-muted-foreground">outline, icon · 42 px</code>
                  <button type="button" class:list={cn(buttonVariants({ variant: "outline", size: "icon" }))}>
                    <RefreshCw aria-hidden="true" strokeWidth={2.2} className="size-4.5" />
                    <span class="sr-only">Odśwież ceny</span>
                  </button>
                </li>
                <li class="flex flex-col items-start gap-1">
                  <code class="text-xs text-muted-foreground">underlined, inline · link przy tekście</code>
                  <Button type="button" variant="underlined" size="inline">
                    Pokaż zapisaną decyzję
                  </Button>
                </li>
                {REGISTRY_SIZES.map((size) => (
                  <li class="flex flex-col items-start gap-1">
                    <code class="text-xs text-muted-foreground">{`default, ${size} · z rejestru, strefa dotyku 44 px`}</code>
                    <Button type="button" size={size}>
                      To ten produkt
                    </Button>
                  </li>
                ))}
                <li class="flex flex-col items-start gap-1">
                  <code class="text-xs text-muted-foreground">default, disabled</code>
                  <Button type="button" size="touch" disabled>
                    To ten produkt
                  </Button>
                </li>
                <li class="flex flex-col items-start gap-1">
                  <code class="text-xs text-muted-foreground">outline, disabled</code>
                  <Button type="button" variant="outline" size="touch" disabled>
                    Odśwież ceny
                  </Button>
                </li>
                {LINK_BUTTONS.map(({ variant, text }) => (
                  <li class="flex flex-col items-start gap-1">
                    <code class="text-xs text-muted-foreground">{`<a>, buttonVariants: ${variant}`}</code>
                    <a href={HERE} class:list={cn(buttonVariants({ variant, size: "touch" }))}>
                      {text}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        ))}
      </div>
    </main>
  </div>
</Layout>
