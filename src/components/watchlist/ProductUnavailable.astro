---
// A product's page when there's no product to show: none by that id on the user's list, or one that couldn't be read.
// The page renders it in the product's place and keeps its status (404 or 503) and title; the dev kitchen sink shows
// each branch. Its heading takes the product title's sizes (ProductTitle), where the product's name would stand: the
// desktop's from xl (1280 px), and the phone's below it, where the pane beside the list is too narrow for them.
import { Alert, AlertDescription } from "@/components/ui/alert";

type Props =
  | {
      /** No product by that id on the user's list. */
      reason: "not-found";
      /** Why a decision wasn't saved (`?error=`), as text: a decision posted for a product that isn't there ends here. */
      error?: string | null;
      /**
       * What a removal came to (`?removal=`), as text: a removal whose answer didn't come ends here when it went
       * through after all.
       */
      notice?: string | null;
    }
  | {
      /** The product couldn't be read. */
      reason: "failed";
    };

const props = Astro.props;
// Only the not-found branch shows a decision's error and a removal's notice.
const error = props.reason === "not-found" ? (props.error ?? null) : null;
const notice = props.reason === "not-found" ? (props.notice ?? null) : null;
const HEADING =
  "text-product-title font-extrabold tracking-heading text-balance xl:text-product-title-lg xl:tracking-title";
---

{props.reason === "not-found" ? (
  <>
    <h1 class:list={HEADING}>Nie znaleziono produktu.</h1>
    {notice && (
      <Alert variant="success" role="status">
        <AlertDescription>{notice}</AlertDescription>
      </Alert>
    )}
    {error && (
      <Alert variant="destructive">
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}
  </>
) : (
  <>
    <h1 class:list={HEADING}>Nie udało się wczytać produktu.</h1>
    <p class="text-sm text-muted-foreground lg:text-body">Odśwież stronę, aby spróbować ponownie.</p>
  </>
)}
