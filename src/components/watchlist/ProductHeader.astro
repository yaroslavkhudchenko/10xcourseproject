---
// A product page's header: the product's full name as the page's heading, for screen readers, and its card with the
// photo and the text. The page and the dev kitchen sink render it.
import { Card } from "@/components/ui/card";
import ProductSummary from "@/components/watchlist/ProductSummary.astro";
import { productFullName } from "@/lib/services/watchlist";
import type { WatchlistProduct } from "@/types";

interface Props {
  product: Pick<WatchlistProduct, "brand" | "name" | "caption" | "sizeText" | "imageUrl">;
}

const { product } = Astro.props;
---

<header class="flex flex-col gap-3">
  <h1 class="sr-only">{productFullName(product)}</h1>
  <Card className="flex-row items-center gap-3 p-3">
    <ProductSummary
      brand={product.brand}
      name={product.name}
      caption={product.caption}
      sizeText={product.sizeText}
      imageUrl={product.imageUrl}
    />
  </Card>
</header>
