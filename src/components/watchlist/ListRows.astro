---
// The list's rows in the list's order, those the filter holds, or what stands in their place: that the list couldn't be
// read, that it's empty, or that the filter holds none of its products. Above the rows, an alert for each read that
// failed, as each row then says its price couldn't be read (listRowsOf), never that it has none.
import { Alert, AlertDescription } from "@/components/ui/alert";
import WatchlistRow from "@/components/watchlist/WatchlistRow.astro";
import { inFilter, type ListFilter, type ListRow } from "@/lib/services/watchlist-rows";

interface Props {
  /** Every product's row, in the list's order, or null when the list couldn't be read. */
  rows: ListRow[] | null;
  /** The filter the rows are shown with. */
  filter: ListFilter;
  /** Whether the Natura decisions couldn't be read at all. */
  matchesFailed: boolean;
  /** Whether the prices couldn't be read at all. */
  pricesFailed: boolean;
  /** The product whose page shows the list beside it, drawn selected. */
  selectedId?: string | null;
}

const { rows, filter, matchesFailed, pricesFailed, selectedId = null } = Astro.props;
const shown = rows?.filter((row) => inFilter(row, filter)) ?? [];
---

{rows === null ? (
  <Alert variant="destructive">
    <AlertDescription>Nie udało się wczytać listy. Odśwież stronę.</AlertDescription>
  </Alert>
) : rows.length === 0 ? (
  <p class="text-sm text-muted-foreground">Twoja lista jest pusta. Wyszukaj produkt powyżej.</p>
) : (
  <div class="flex flex-col gap-2.5 lg:gap-3">
    {matchesFailed && (
      <Alert variant="destructive">
        <AlertDescription>Nie udało się wczytać dopasowań w Naturze. Odśwież stronę.</AlertDescription>
      </Alert>
    )}
    {pricesFailed && (
      <Alert variant="destructive">
        <AlertDescription>Nie udało się wczytać cen. Odśwież stronę.</AlertDescription>
      </Alert>
    )}
    {shown.length === 0 ? (
      <p class="text-sm text-muted-foreground">Żaden produkt nie pasuje do tego filtra.</p>
    ) : (
      <ul aria-label="Moja lista" class="flex flex-col gap-2.5 lg:gap-3">
        {shown.map((row) => (
          <li>
            <WatchlistRow row={row} filter={filter} selected={row.itemId === selectedId} />
          </li>
        ))}
      </ul>
    )}
  </div>
)}
