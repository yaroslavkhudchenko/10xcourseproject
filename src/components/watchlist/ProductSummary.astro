---
// A product's thumbnail and text, shared by the search results and the watchlist.
interface Props {
  brand: string | null;
  name: string;
  caption: string | null;
  sizeText: string | null;
  imageUrl: string | null;
  detail?: string;
}

// `name` would read as the deprecated global window.name inside the template, so it gets a local name of its own.
const { brand, name: productName, caption, sizeText, imageUrl, detail } = Astro.props;
---

<div class="flex min-w-0 flex-1 items-center gap-3">
  {imageUrl ? (
    <img
      src={imageUrl}
      alt=""
      width="56"
      height="56"
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      class="size-14 shrink-0 rounded-lg bg-white object-contain"
    />
  ) : (
    <div aria-hidden="true" class="size-14 shrink-0 rounded-lg bg-white/10" />
  )}
  <div class="min-w-0">
    <p class="font-medium">
      {brand && <span class="text-blue-100/70">{brand}</span>}
      {productName}
    </p>
    {caption && <p class="line-clamp-2 text-sm text-blue-100/70">{caption}</p>}
    <p class="text-sm text-blue-100/60">
      {sizeText ?? "rozmiar nieznany"}
      {detail && <span> · {detail}</span>}
    </p>
  </div>
</div>
