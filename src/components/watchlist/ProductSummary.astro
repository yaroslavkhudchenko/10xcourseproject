---
// A product's thumbnail and text, for the items of a product page's Natura section.
interface Props {
  brand: string | null;
  name: string;
  caption: string | null;
  sizeText: string | null;
  imageUrl: string | null;
  detail?: string;
}

// `name` would read as the deprecated global window.name inside the template, so it gets a local name of its own.
const { brand, name: productName, caption, sizeText, imageUrl, detail } = Astro.props;
---

<div class="flex min-w-0 flex-1 items-center gap-3">
  {imageUrl ? (
    <img
      src={imageUrl}
      alt=""
      width="56"
      height="56"
      loading="lazy"
      decoding="async"
      class="size-14 shrink-0 rounded-lg bg-thumbnail object-contain"
    />
  ) : (
    <div aria-hidden="true" class="size-14 shrink-0 rounded-lg bg-muted" />
  )}
  <div class="min-w-0">
    <p class="font-medium">
      {/* Astro drops the line break between two expressions, so the space after the brand is written out. */}
      {brand && (
        <>
          <span class="text-muted-foreground">{brand}</span>{" "}
        </>
      )}
      {productName}
    </p>
    {caption && <p class="line-clamp-2 text-sm text-muted-foreground">{caption}</p>}
    <p class="text-sm text-muted-foreground">
      {sizeText ?? "rozmiar nieznany"}
      {detail && <span> · {detail}</span>}
    </p>
  </div>
</div>
