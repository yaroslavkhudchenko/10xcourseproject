---
// A password field: the Input, of type password, with a button that shows the password and hides it again. The button
// needs JavaScript, so it stays hidden until its script runs, as the theme switch does, and without it the field is a
// plain password field. It's a toggle named "Pokaż hasło", whose aria-pressed says whether the password shows: an eye
// while it's hidden, a crossed-out eye while it shows. It stands 38 px inside the field's right end, with a 44 px hit
// area (hit-area), and the field keeps its text clear of it. Each field's own button shows it, and the field hides it
// again when its form is sent, so the browser never keeps it as plain text. A page may hold several: the script handles
// each, and Astro includes it once per page.
import { Eye, EyeOff } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { cn } from "@/lib/utils";

interface Props {
  /** The field's id, which its label names. */
  id: string;
  /** The field's name in its form. */
  name: string;
  /** What a password manager fills in: the account's password, or a new one. */
  autocomplete: "current-password" | "new-password";
  /** The fewest characters the field takes, if it has a minimum. */
  minlength?: number;
  /** The most characters the field takes, if it has a maximum. */
  maxlength?: number;
}

const { id, name, autocomplete, minlength, maxlength } = Astro.props;
---

<div class="relative" data-password-field>
  <Input
    id={id}
    name={name}
    type="password"
    autoComplete={autocomplete}
    required
    minLength={minlength}
    maxLength={maxlength}
    className="pr-14"
  />
  <div class="absolute inset-y-0 right-1.5 flex items-center">
    <button
      type="button"
      data-password-toggle
      aria-controls={id}
      aria-pressed="false"
      hidden
      class:list={cn(
        buttonVariants({ variant: "ghost", size: "icon" }),
        "group size-9.5 rounded-search-button text-muted-foreground",
      )}
    >
      <Eye aria-hidden="true" strokeWidth={2.2} className="size-4.5 group-aria-pressed:hidden" />
      <EyeOff aria-hidden="true" strokeWidth={2.2} className="hidden size-4.5 group-aria-pressed:block" />
      <span class="sr-only">Pokaż hasło</span>
    </button>
  </div>
</div>

<script>
  // Each field's button shows its password and hides it again: the field's type switches between password and text,
  // and aria-pressed says whether the password shows. Sending the form hides it first, so the browser doesn't keep a
  // text field's value in its form history. The button does nothing without JavaScript, so it shows only from here.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>("button[data-password-toggle]")) {
    const field = toggle.closest("[data-password-field]")?.querySelector("input");
    if (!(field instanceof HTMLInputElement)) {
      continue;
    }
    const show = (shown: boolean) => {
      field.type = shown ? "text" : "password";
      toggle.setAttribute("aria-pressed", String(shown));
    };
    toggle.addEventListener("click", () => {
      show(field.type === "password");
    });
    field.form?.addEventListener("submit", () => {
      show(false);
    });
    toggle.hidden = false;
  }
</script>
