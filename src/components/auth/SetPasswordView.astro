---
// The set-password form in the auth shell's card, as the set-password page and the kitchen sink draw it: the page's
// heading, what a new password needs, a refused password's error, then the form. It's a plain form, which works without
// JavaScript: one password field with its label, which a password manager fills with a new password (autocomplete),
// held by the browser to 8 to 72 characters as a first check, while the route counts bytes, as Auth does; and "Zapisz
// hasło", posted to /api/auth/set-password once (SubmitOnce). It renders from its props alone, so the page and the
// kitchen sink show the same thing.
import PasswordInput from "@/components/auth/PasswordInput.astro";
import SubmitOnce from "@/components/SubmitOnce.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import { PASSWORD_MAX_LENGTH, PASSWORD_MIN_LENGTH } from "@/lib/services/auth";

interface Props {
  /** Why the last password wasn't saved, as text (`?error=`), or null. */
  error?: string | null;
  /** What the field's id starts with, apart for each form where the kitchen sink draws several. */
  idPrefix?: string;
}

const { error = null, idPrefix = "" } = Astro.props;
const passwordId = `${idPrefix}new-password`;
const HINT = `Wybierz hasło do konta: od ${PASSWORD_MIN_LENGTH} do ${PASSWORD_MAX_LENGTH} znaków.`;
---

<div class="flex flex-col gap-5 lg:gap-6">
  <h1 class="text-2xl font-extrabold tracking-heading">Nowe hasło</h1>
  <p class="text-sm text-muted-foreground">{HINT}</p>
  {error && (
    <Alert variant="destructive">
      <AlertDescription>{error}</AlertDescription>
    </Alert>
  )}
  <form method="POST" action="/api/auth/set-password" data-submit-once class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <label for={passwordId} class="text-sm font-bold">
        Hasło
      </label>
      <PasswordInput
        id={passwordId}
        name="password"
        autocomplete="new-password"
        minlength={PASSWORD_MIN_LENGTH}
        maxlength={PASSWORD_MAX_LENGTH}
      />
    </div>
    {/* The phone bottom bar's primary button: 52 px, radius 16, 16 px extra bold, across the card. */}
    <Button type="submit" size="touch" className="mt-2 h-13 w-full rounded-button-lg text-base font-extrabold">
      Zapisz hasło
    </Button>
  </form>
</div>
<SubmitOnce />
