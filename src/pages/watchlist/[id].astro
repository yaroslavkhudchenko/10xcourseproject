---
import { ChevronLeft } from "lucide-react";
import SubmitOnce from "@/components/SubmitOnce.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import ListFooter from "@/components/watchlist/ListFooter.astro";
import ListHead from "@/components/watchlist/ListHead.astro";
import ListRows from "@/components/watchlist/ListRows.astro";
import { naturaUnreadable, type NaturaCardInput } from "@/components/watchlist/natura-card";
import NaturaSection from "@/components/watchlist/NaturaSection.astro";
import PriceComparison from "@/components/watchlist/PriceComparison";
import {
  initialState,
  rowShopsOfIsland,
  type PriceComparisonShop,
} from "@/components/watchlist/price-comparison-state";
import ProductUnavailable from "@/components/watchlist/ProductUnavailable.astro";
import WatchlistShell from "@/layouts/WatchlistShell.astro";
import { ERROR_PARAM, LIST_PRICES_PARAM, PRICES_NOTICES, PRICES_PARAM } from "@/lib/notices";
import { decideMatchStep } from "@/lib/services/match-step";
import {
  listMatches,
  listMatchStates,
  matchErrorMessage,
  recordLookup,
  type MatchStatesRead,
} from "@/lib/services/matches";
import {
  chooseView,
  decisionNotice,
  matchedView,
  notFoundView,
  promptView,
  storedView,
  type NaturaView,
} from "@/lib/services/natura-view";
import { keyText, SHOP_LABELS, type PricedShop } from "@/lib/services/price-comparison";
import { parsePriceRefreshCode } from "@/lib/services/price-refresh";
import { listLatestPrices, readLatestPrices, recordPriceChecks, type ListPricesRead } from "@/lib/services/prices";
import { isOwnNavigation } from "@/lib/services/search-query";
import { shopGateFor } from "@/lib/services/shop-gate";
import { lookupInNatura } from "@/lib/services/shop-matching";
import { getWatchlistProduct, listWatchlist, parseWatchlistItemId, productFullName } from "@/lib/services/watchlist";
import {
  filterHref,
  listChipsOf,
  listRowsOf,
  parseListFilter,
  rowProductOf,
  rowTagOf,
} from "@/lib/services/watchlist-rows";
import { shopUnavailableText } from "@/lib/shop-messages";
import { cn } from "@/lib/utils";
import type { MatchedItem, ShopMatch, WatchlistItem, WatchlistProduct } from "@/types";

const { user, supabase } = Astro.locals;
const params = Astro.url.searchParams;
// A link on another site or a prefetch must not spend the cap everyone shares: only the user's own navigation may make
// opening the page ask a shop, for a Natura lookup or a price.
const ownNavigation = isOwnNavigation(Astro.request.headers);

// Only a UUID reaches the database, and another user's product reads as no product at all (RLS): neither makes a shop
// call. The product and its stored decisions need only the id, so both are read at once; the decisions count only
// once the product is there.
const id = parseWatchlistItemId(Astro.params.id);
type ProductReads = [WatchlistProduct | null | "failed", ShopMatch[] | null];
const productReads: Promise<ProductReads> =
  id === null
    ? Promise.resolve<ProductReads>([null, null])
    : supabase
      ? Promise.all([getWatchlistProduct(supabase, id), listMatches(supabase, id)])
      : Promise.resolve<ProductReads>(["failed", null]);
// The list beside the product, from lg: the list page's own three reads, at the same time as the product's. They ask
// no shop, and a phone, which doesn't show the list, still makes them, since the server can't know the screen's width.
type ListReads = [WatchlistItem[] | null, MatchStatesRead | null, ListPricesRead | null];
const listReads: Promise<ListReads> = supabase
  ? Promise.all([listWatchlist(supabase), listMatchStates(supabase), listLatestPrices(supabase)])
  : Promise.resolve<ListReads>([null, null, null]);
const [[product, matches], [items, matchRead, priceRead]] = await Promise.all([productReads, listReads]);
if (product === null) {
  Astro.response.status = 404;
} else if (product === "failed") {
  Astro.response.status = 503;
}

const retrying = params.get("retry") === "1";
let natura: NaturaView | null = null;
// Set when the lookup's own outcome couldn't be stored: the next visit then looks the product up again.
let unsaved = false;
// The product's stored match in Natura, or the one this render just stored: its prices are shown next to Rossmann's.
let naturaItem: MatchedItem | null = null;
if (supabase && product !== null && product !== "failed") {
  const step = decideMatchStep({ matches, shop: "natura", retrying, ownNavigation });
  if (step.kind === "read-failed") {
    // Without the stored decision, a lookup could ask again about what the user has already settled.
    natura = { kind: "read-failed" };
  } else if (step.kind === "stored") {
    natura = storedView(step.match, product);
    naturaItem = step.match.item;
  } else if (step.kind === "prompt") {
    // A link on another site or a prefetch only gets the button.
    natura = promptView(product, retrying);
  } else {
    const lookup = await lookupInNatura(shopGateFor(supabase), product);
    const fetchedAt = new Date();
    if (lookup.kind === "accepted" || lookup.kind === "not-found") {
      // What the rule settles on its own is stored during this render; the user's picks go through the form.
      const result = await recordLookup(supabase, product.id, "natura", lookup);
      if (lookup.kind === "accepted" && result === "saved") {
        naturaItem = lookup.candidate;
        const { shopItemId, offer } = lookup.candidate;
        if (offer !== null) {
          // The price Natura sent with the match is its first stored price, so the island needn't ask Natura again.
          // A failed insert is logged, and the island then asks.
          await recordPriceChecks(supabase, [{ key: { shop: "natura", shopItemId }, check: { kind: "price", offer } }]);
        }
      }
      if (step.retry && result === "saved") {
        // The plain URL shows the stored outcome, so a `?retry=1` left in the address bar can't repeat the lookup.
        return Astro.redirect(`/watchlist/${product.id}`);
      }
      unsaved = result === "failed" || result === "gone";
      if (result === "decided") {
        // Another tab stored a decision meanwhile; it stands.
        natura = { kind: "decided" };
      } else if (lookup.kind === "accepted") {
        // A match that wasn't saved has no price row, so its card shows its item.
        natura = matchedView(lookup.candidate, "auto", product, { unsaved });
      } else {
        natura = notFoundView(fetchedAt, product);
      }
    } else if (lookup.kind === "choose") {
      natura = chooseView(lookup.options, lookup.via, fetchedAt, product);
    } else {
      // Nothing is stored: Natura can be asked again later.
      natura = {
        kind: "unavailable",
        message: shopUnavailableText(SHOP_LABELS.natura.name, lookup.reason, lookup.until),
      };
    }
  }
}

// The prices of the product's matched shops: its own Rossmann item, where it was picked, and its Natura match. They're
// read after the Natura step, so a match it has just stored comes with the price it was found with.
let priceShops: PriceComparisonShop[] = [];
let pricesFailed = false;
if (supabase && product !== null && product !== "failed") {
  const matched: { shop: PricedShop; shopItemId: string; productUrl: string | null }[] = [];
  if (product.source === "rossmann") {
    matched.push({ shop: "rossmann", shopItemId: product.sourceItemId, productUrl: product.productUrl });
  }
  if (naturaItem !== null) {
    matched.push({ shop: "natura", shopItemId: naturaItem.shopItemId, productUrl: naturaItem.productUrl });
  }
  const read = await readLatestPrices(
    supabase,
    matched.map(({ shop, shopItemId }) => ({ shop, shopItemId })),
  );
  // Without the stored prices the island still shows every shop, each saying its price couldn't be read until its
  // shop answers; a shop whose own row couldn't be read says so too. Either way no shop is named cheapest meanwhile.
  pricesFailed = read === null;
  const latest = new Map((read?.prices ?? []).map((price) => [keyText(price), price] as const));
  const unread = new Set((read?.unread ?? []).map(keyText));
  priceShops = matched.map(({ shop, shopItemId, productUrl }) => {
    const key = keyText({ shop, shopItemId });
    return { shop, productUrl, latest: latest.get(key) ?? null, readFailed: unread.has(key) };
  });
}
// The server's time for the island's first render, so the ages it shows match this page's HTML.
const renderedAt = new Date().toISOString();

const title =
  product === null
    ? "Nie znaleziono produktu"
    : product === "failed"
      ? "Nie udało się wczytać produktu"
      : productFullName(product);
// A decision's notice and error, which Natura's card shows.
const notice = decisionNotice(params);
const error = matchErrorMessage(params.get(ERROR_PARAM));
// Natura for the island's card. A choice's candidates stay out of the island: the section below it holds their forms.
const naturaInput: NaturaCardInput | null =
  natura === null
    ? null
    : { view: natura.kind === "choose" ? { ...natura, options: [] } : natura, notice, error, unsaved };
const choice = natura?.kind === "choose" ? natura : null;

// What "Odśwież ceny" came to when its form was posted without JavaScript, in the product's own words (notices.ts): a
// code the app didn't send shows nothing.
const pricesCode = parsePriceRefreshCode(params.get(PRICES_PARAM));
const pricesNotice = pricesCode === null ? null : PRICES_NOTICES[pricesCode];

// The phone's way back to the list, with the filter the list was shown with (a row's link carries it); any other value
// of `f` goes back to the whole list.
const backHref = filterHref("/watchlist", parseListFilter(params.get("f")));
// The brand and the size beside it, as the product's row on the list shows them.
const backEyebrow = product === null || product === "failed" ? null : rowProductOf(product).eyebrow;

// The list beside the product, from lg, as the list page shows it, with this product's row selected. The row's tag is
// judged from this page's own reads, the ones the island starts from, so the two agree from the first paint, with
// JavaScript or without; the island then keeps it up to date (PRICES_EVENT). The chips and "Odśwież ceny" keep the
// product, and a product that isn't there leaves them to the list.
const shown = product !== null && product !== "failed" ? product : null;
const selectedTag =
  shown === null
    ? null
    : rowTagOf(
        rowShopsOfIsland(initialState({ shops: priceShops, now: renderedAt, pricesFailed }).rows, {
          naturaUnreadable: naturaUnreadable(natura),
        }),
        Date.parse(renderedAt),
      );
const listRows =
  items === null
    ? null
    : listRowsOf(items, matchRead, priceRead, Date.now()).map((row) =>
        selectedTag !== null && row.itemId === shown?.id ? { ...row, tag: selectedTag } : row,
      );
const { counts, filter } = listChipsOf(listRows, matchRead !== null && priceRead !== null, params.get("f"));
const listPath = shown === null ? "/watchlist" : `/watchlist/${shown.id}`;
// "Moja lista", the heading of the list beside the product, which names the list's landmark.
const LIST_HEADING_ID = "list-heading";
---

<WatchlistShell
  title={`${title} · Drogeria Radar`}
  mode="product"
  email={user?.email ?? null}
  listHeadingId={LIST_HEADING_ID}
>
  <ListHead
    slot="head"
    headingId={LIST_HEADING_ID}
    level={2}
    count={items?.length ?? null}
    path={listPath}
    filter={filter}
    counts={counts}
    refreshCode={parsePriceRefreshCode(params.get(LIST_PRICES_PARAM))}
    back={shown?.id ?? null}
  />
  <ListRows
    slot="rows"
    rows={listRows}
    filter={filter}
    matchesFailed={matchRead === null}
    pricesFailed={priceRead === null}
    selectedId={shown?.id ?? null}
  />
  {counts !== null && <ListFooter slot="footer" />}

  {/* A phone's top row, back to the list. From lg the header and the list stand beside the product instead. */}
  <div class="flex items-center justify-between gap-3 pt-1 lg:hidden">
    <a href={backHref} class:list={cn(buttonVariants({ variant: "link", size: "inline" }), "h-11 gap-0.5 text-base")}>
      <ChevronLeft aria-hidden="true" strokeWidth={2.4} className="size-5.5" />
      Moja lista
    </a>
    {backEyebrow && (
      <span class="font-mono text-meta tracking-eyebrow wrap-break-word text-muted-foreground uppercase">
        {backEyebrow}
      </span>
    )}
  </div>

  {product === null ? (
    <div class="flex flex-col gap-3 pt-2 lg:pt-0">
      <ProductUnavailable reason="not-found" error={error} />
    </div>
  ) : product === "failed" ? (
    <div class="flex flex-col gap-3 pt-2 lg:pt-0">
      <ProductUnavailable reason="failed" />
    </div>
  ) : (
    <div class="flex flex-col gap-6 pt-2 pb-28 lg:gap-6.5 lg:pt-0 lg:pb-0">
      {/* Below lg the island's bottom bar is fixed over the screen's foot, so the page's content ends above it. */}
      {pricesNotice && (
        <Alert variant={pricesNotice.warning ? "warning" : "success"} role={pricesNotice.warning ? "alert" : "status"}>
          <AlertDescription>{pricesNotice.text}</AlertDescription>
        </Alert>
      )}
      <PriceComparison
        client:load
        itemId={product.id}
        product={{
          brand: product.brand,
          name: product.name,
          caption: product.caption,
          sizeText: product.sizeText,
          imageUrl: product.imageUrl,
          addedAt: product.addedAt,
        }}
        natura={naturaInput}
        shops={priceShops}
        autoRefresh={ownNavigation}
        now={renderedAt}
        pricesFailed={pricesFailed}
      />

      {/* Natura's card, among the island's cards, points here when the user has candidates to choose from. */}
      {choice && <NaturaSection view={choice} productId={product.id} />}
    </div>
  )}
  <SubmitOnce />
  <script>
    // The codes are the ones the frontmatter reads its notices by, from a module that imports nothing, so this script
    // ships no server code.
    import { NOTICE_PARAMS } from "@/lib/notices";

    // A notice shows once: the address bar forgets the code that brought it, a decision's (matched, declined, decided,
    // error), the product's no-JavaScript refresh's (prices) or the list's refresh's (list-prices), so a reload or a
    // copied link doesn't show it again. Every other parameter, the list's filter among them, and the hash stay.
    const url = new URL(window.location.href);
    if (NOTICE_PARAMS.some((code) => url.searchParams.has(code))) {
      for (const code of NOTICE_PARAMS) {
        url.searchParams.delete(code);
      }
      history.replaceState(history.state, "", url);
    }
  </script>
</WatchlistShell>
