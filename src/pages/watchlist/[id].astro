---
import { ChevronLeft } from "lucide-react";
import SubmitOnce from "@/components/SubmitOnce.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import ListFooter from "@/components/watchlist/ListFooter.astro";
import ListHead from "@/components/watchlist/ListHead.astro";
import ListRows from "@/components/watchlist/ListRows.astro";
import { unreadableShopsOf, type MatchedShopView } from "@/components/watchlist/match-card";
import MatchChoice from "@/components/watchlist/MatchChoice.astro";
import PriceComparison from "@/components/watchlist/PriceComparison";
import { selectedRowTagOf, type PriceComparisonShop } from "@/components/watchlist/price-comparison-state";
import ProductUnavailable from "@/components/watchlist/ProductUnavailable.astro";
import RemoveProduct from "@/components/watchlist/RemoveProduct.astro";
import WatchlistShell from "@/layouts/WatchlistShell.astro";
import { ERROR_PARAM, LIST_PRICES_PARAM, PRICES_NOTICES, PRICES_PARAM, REMOVAL_PARAM } from "@/lib/notices";
import { autoRefreshOf, repinShopOf, retryShopOf } from "@/lib/services/match-step";
import { decisionError, decisionNotice } from "@/lib/services/match-view";
import {
  listMatches,
  listMatchStates,
  matchErrorMessage,
  type MatchesRead,
  type MatchStatesRead,
} from "@/lib/services/matches";
import { productPriceKeys, type MatchedShop, type PriceDecision } from "@/lib/services/price-comparison";
import { parsePriceRefreshCode } from "@/lib/services/price-refresh";
import { listLatestPrices, priceShopsOf, readLatestPrices, type ListPricesRead } from "@/lib/services/prices";
import { isOwnNavigation } from "@/lib/services/search-query";
import { shopGateFor } from "@/lib/services/shop-gate";
import { runMatchSteps } from "@/lib/services/shop-matching";
import {
  getWatchlistProduct,
  listWatchlist,
  parseWatchlistItemId,
  productFullName,
  removalErrorMessage,
  removalGoneNotice,
} from "@/lib/services/watchlist";
import { filterHref, listChipsOf, listRowsOf, parseListFilter, rowProductOf } from "@/lib/services/watchlist-rows";
import { cn } from "@/lib/utils";
import type { MatchedItem, WatchlistItem, WatchlistProduct } from "@/types";

const { user, supabase } = Astro.locals;
const params = Astro.url.searchParams;
// A link on another site or a prefetch must not spend the cap everyone shares: only the user's own navigation may make
// opening the page ask a shop, for a matched shop's lookup or a price.
const ownNavigation = isOwnNavigation(Astro.request.headers);

// Only a UUID reaches the database, and another user's product reads as no product at all (RLS): neither makes a shop
// call. The product and its stored decisions need only the id, so both are read at once; the decisions count only
// once the product is there.
const id = parseWatchlistItemId(Astro.params.id);
type ProductReads = [WatchlistProduct | null | "failed", MatchesRead | null];
const productReads: Promise<ProductReads> =
  id === null
    ? Promise.resolve<ProductReads>([null, null])
    : supabase
      ? Promise.all([getWatchlistProduct(supabase, id), listMatches(supabase, id)])
      : Promise.resolve<ProductReads>(["failed", null]);
// The list beside the product, from lg: the list page's own three reads, at the same time as the product's. They ask
// no shop, and a phone, which doesn't show the list, still makes them, since the server can't know the screen's width.
type ListReads = [WatchlistItem[] | null, MatchStatesRead | null, ListPricesRead | null];
const listReads: Promise<ListReads> = supabase
  ? Promise.all([listWatchlist(supabase), listMatchStates(supabase), listLatestPrices(supabase)])
  : Promise.resolve<ListReads>([null, null, null]);
const [[product, matches], [items, matchRead, priceRead]] = await Promise.all([productReads, listReads]);
if (product === null) {
  Astro.response.status = 404;
} else if (product === "failed") {
  Astro.response.status = 503;
}
// The product the page shows, when there is one.
const shown = product !== null && product !== "failed" ? product : null;

// The shop the page was opened to look up again (`?retry=natura`) or to change the stored decision of
// (`?repin=natura`), if any.
const retryShop = retryShopOf(params);
const repinShop = repinShopOf(params);
// The filter the list was shown with, which every link, form and redirect of the page keeps, so the list beside the
// product keeps its chip; any other value of `f` is the whole list.
const listFilter = parseListFilter(params.get("f"));
// What the page does for each matched shop, in MATCHED_SHOPS order (runMatchSteps): its card's view, the choice the
// user opened to change its stored decision ("Zmień", "Dopasuj ponownie"), whether the lookup's own outcome couldn't
// be stored, its stored or just stored match, whose prices are shown next to Rossmann's, and whether a retry stored its
// outcome. The shops' lookups run at once, each shop's searches one after the other, and a shop whose step throws
// shows as unavailable beside the others. The steps also tell whether the island may refetch on its own.
const steps =
  supabase && shown !== null
    ? await runMatchSteps({
        supabase,
        gate: shopGateFor(supabase),
        product: shown,
        matches,
        retryShop,
        repinShop,
        ownNavigation,
        filter: listFilter,
      })
    : [];
if (shown !== null && steps.some((each) => each.retried)) {
  // The plain URL shows the stored outcome, so a `?retry=<shop>` left in the address bar can't repeat the lookup.
  return Astro.redirect(filterHref(`/watchlist/${shown.id}`, listFilter));
}

// The prices of the product's matched shops: its own Rossmann item, where it was picked, and each matched shop's match,
// as productPriceKeys gives them. They're read after the steps, so a match a step has just stored comes with the price
// it was found with.
let priceShops: PriceComparisonShop[] = [];
let pricesFailed = false;
if (supabase && shown !== null) {
  // Each matched shop's item: its stored match, or the one this render just stored.
  const matchedItems = new Map<MatchedShop, MatchedItem>(
    steps.flatMap(({ shop, item }) => (item === null ? [] : [[shop, item] as const])),
  );
  const keys = productPriceKeys(
    shown,
    [...matchedItems].map(([shop, item]): PriceDecision => ({ shop, state: "matched", shopItemId: item.shopItemId })),
  );
  // Without the stored prices the island still shows every shop, each saying its price couldn't be read until its
  // shop answers; a shop whose own row couldn't be read says so too (priceShopsOf). "Zobacz w sklepie" goes to the
  // product's own page where it was picked, and to its matched item's elsewhere.
  ({ shops: priceShops, pricesFailed } = priceShopsOf(keys, await readLatestPrices(supabase, keys), (shop) =>
    shop === "rossmann" ? shown.productUrl : (matchedItems.get(shop)?.productUrl ?? null),
  ));
}
// The server's time for the island's first render, so the ages it shows match this page's HTML.
const renderedAt = new Date().toISOString();
const autoRefresh = autoRefreshOf(
  steps.map(({ step }) => step),
  ownNavigation,
);

const title =
  product === null
    ? "Nie znaleziono produktu"
    : product === "failed"
      ? "Nie udało się wczytać produktu"
      : productFullName(product);
// A decision's notice and a decision's error, each shown by the card of the shop it was for. Without the product, the
// page shows a decision's error whatever its shop.
const decision = decisionNotice(params);
const decisionFailure = decisionError(params);
const error = matchErrorMessage(params.get(ERROR_PARAM));
// Each matched shop for the island's card, in MATCHED_SHOPS order. A choice's candidates stay out of the island: the
// shop's section below it holds their forms, a first choice's or the one the user opened to change the stored decision.
const matched: MatchedShopView[] = steps.map(({ shop, view, unsaved }) => ({
  shop,
  view: view.kind === "choose" ? { ...view, options: [] } : view,
  notice: decision?.shop === shop ? decision.text : null,
  error: decisionFailure?.shop === shop ? decisionFailure.text : null,
  unsaved,
}));
// Each shop's choice below the island, in the same order: its first choice's candidates, or the ones the user opened
// to change its stored decision.
const choices = steps.flatMap(({ shop, view, repin }) => {
  const choice = repin ?? (view.kind === "choose" ? view : null);
  return choice === null ? [] : [{ shop, view: choice }];
});

// What "Odśwież ceny" came to when its form was posted without JavaScript, in the product's own words (notices.ts): a
// code the app didn't send shows nothing.
const pricesCode = parsePriceRefreshCode(params.get(PRICES_PARAM));
const pricesNotice = pricesCode === null ? null : PRICES_NOTICES[pricesCode];
// A removal that failed comes back here with its code, which opens the confirm again with its error, or, when the
// product isn't there any more because the removal went through after all, says so (notices.ts): a code the app
// didn't send shows nothing.
const removalError = removalErrorMessage(params.get(REMOVAL_PARAM));
const removalGone = removalGoneNotice(params.get(REMOVAL_PARAM));

// The phone's way back to the list, with the filter the list was shown with (a row's link carries it).
const backHref = filterHref("/watchlist", listFilter);
// The brand and the size beside it, as the product's row on the list shows them.
const backEyebrow = shown === null ? null : rowProductOf(shown).eyebrow;

// The list beside the product, from lg, as the list page shows it, with this product's row selected. The row's tag is
// judged from this page's own reads, the ones the island starts from (selectedRowTagOf). The chips and "Odśwież ceny"
// keep the product, and a product that isn't there leaves them to the list.
const selectedTag =
  shown === null ? null : selectedRowTagOf(priceShops, pricesFailed, unreadableShopsOf(matched), renderedAt);
const listRows =
  items === null
    ? null
    : listRowsOf(items, matchRead, priceRead, Date.now()).map((row) =>
        selectedTag !== null && row.itemId === shown?.id ? { ...row, tag: selectedTag } : row,
      );
const { counts, filter } = listChipsOf(listRows, matchRead !== null && priceRead !== null, listFilter);
const listPath = shown === null ? "/watchlist" : `/watchlist/${shown.id}`;
// "Moja lista", the heading of the list beside the product, which names the list's landmark.
const LIST_HEADING_ID = "list-heading";
---

<WatchlistShell
  title={`${title} · Drogeria Radar`}
  mode="product"
  email={user?.email ?? null}
  listHeadingId={LIST_HEADING_ID}
>
  <ListHead
    slot="head"
    headingId={LIST_HEADING_ID}
    level={2}
    count={items?.length ?? null}
    path={listPath}
    filter={filter}
    counts={counts}
    refreshCode={parsePriceRefreshCode(params.get(LIST_PRICES_PARAM))}
    back={shown?.id ?? null}
  />
  <ListRows
    slot="rows"
    rows={listRows}
    filter={filter}
    matchesFailed={matchRead === null}
    pricesFailed={priceRead === null}
    selectedId={shown?.id ?? null}
  />
  {counts !== null && <ListFooter slot="footer" />}

  {/* A phone's top row, back to the list. From lg the header and the list stand beside the product instead. */}
  <div class="flex items-center justify-between gap-3 pt-1 lg:hidden">
    <a href={backHref} class:list={cn(buttonVariants({ variant: "link", size: "inline" }), "h-11 gap-0.5 text-base")}>
      <ChevronLeft aria-hidden="true" strokeWidth={2.4} className="size-5.5" />
      Moja lista
    </a>
    {backEyebrow && (
      <span class="font-mono text-meta tracking-eyebrow wrap-break-word text-muted-foreground uppercase">
        {backEyebrow}
      </span>
    )}
  </div>

  {product === null ? (
    <div class="flex flex-col gap-3 pt-2 lg:pt-0">
      <ProductUnavailable reason="not-found" error={error} notice={removalGone} />
    </div>
  ) : product === "failed" ? (
    <div class="flex flex-col gap-3 pt-2 lg:pt-0">
      <ProductUnavailable reason="failed" />
    </div>
  ) : (
    <div class="flex flex-col gap-6 pt-2 pb-28 lg:gap-6.5 lg:pt-0 lg:pb-0">
      {/* Below lg the island's bottom bar is fixed over the screen's foot, so the page's content ends above it. */}
      {pricesNotice && (
        <Alert variant={pricesNotice.warning ? "warning" : "success"} role={pricesNotice.warning ? "alert" : "status"}>
          <AlertDescription>{pricesNotice.text}</AlertDescription>
        </Alert>
      )}
      <PriceComparison
        client:load
        itemId={product.id}
        listFilter={listFilter}
        product={{
          brand: product.brand,
          name: product.name,
          caption: product.caption,
          sizeText: product.sizeText,
          imageUrl: product.imageUrl,
          addedAt: product.addedAt,
        }}
        matched={matched}
        shops={priceShops}
        autoRefresh={autoRefresh}
        now={renderedAt}
        pricesFailed={pricesFailed}
      />

      {/* A shop's card among the island's cards points to its choice here, while it has candidates to choose from. */}
      {choices.map(({ shop, view }) => (
        <MatchChoice shop={shop} view={view} productId={product.id} filter={listFilter} />
      ))}
      {/* The product's own removal, last at every width, which confirms in place and asks no shop. */}
      <RemoveProduct productId={product.id} filter={listFilter} error={removalError} />
    </div>
  )}
  <SubmitOnce />
  <script>
    // The codes are the ones the frontmatter reads its notices by, from a module that imports nothing server-only, so
    // this script ships no server code.
    import { NOTICE_PARAMS, withoutNotices } from "@/lib/notices";

    // A notice shows once: the address bar forgets the code that brought it, a decision's (matched, declined, decided,
    // error) with its shop (shop), the product's no-JavaScript refresh's (prices), the list's refresh's (list-prices) or
    // a failed removal's (removal), so a reload or a copied link doesn't show it again. It forgets a re-pin's (repin)
    // and a retry's (retry) too once the page has rendered, so going back to it or reloading it asks the shop nothing,
    // even when the lookup only opened a choice. Every other parameter, the list's filter among them, and the hash stay
    // (withoutNotices).
    const forgotten = withoutNotices(window.location.href, NOTICE_PARAMS);
    if (forgotten !== null) {
      history.replaceState(history.state, "", forgotten);
    }
  </script>
</WatchlistShell>
