---
import SubmitOnce from "@/components/SubmitOnce.astro";
import SearchForm from "@/components/shell/SearchForm.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import ListFooter from "@/components/watchlist/ListFooter.astro";
import ListHead from "@/components/watchlist/ListHead.astro";
import ListRows from "@/components/watchlist/ListRows.astro";
import SearchResults from "@/components/watchlist/SearchResults.astro";
import WatchlistShell from "@/layouts/WatchlistShell.astro";
import {
  ERROR_PARAM,
  EXISTS_NOTICE,
  EXISTS_PARAM,
  LIST_PRICES_PARAM,
  PASSWORD_SET_NOTICE,
  PASSWORD_SET_PARAM,
  REMOVED_PARAM,
  SIGN_OUT_PARAM,
  signOutErrorMessage,
} from "@/lib/notices";
import { listMatchStates } from "@/lib/services/matches";
import { SHOP_LABELS } from "@/lib/services/price-comparison";
import { parsePriceRefreshCode } from "@/lib/services/price-refresh";
import { listLatestPrices } from "@/lib/services/prices";
import { shopGateFor } from "@/lib/services/shop-gate";
import { searchStepOf } from "@/lib/services/search-query";
import { searchRossmann } from "@/lib/services/shops/rossmann";
import { listChipsOf, listRowsOf } from "@/lib/services/watchlist-rows";
import { listWatchlist, removedNotice, watchlistErrorMessage } from "@/lib/services/watchlist";
import { shopUnavailableText } from "@/lib/shop-messages";

const { user, supabase } = Astro.locals;
const params = Astro.url.searchParams;
const rawQuery = params.get("q");

// Search runs only on submit, only with text that may go into a shop URL, and only on the user's own navigation: a link
// on another site only fills in the form (searchStepOf).
const searchStep = searchStepOf(rawQuery, Astro.request.headers);
const query = searchStep.kind === "search" || searchStep.kind === "filled" ? searchStep.query : null;
// One search asks Rossmann for one page of at most 24 items.
const SEARCH_SIZE = 24;

// The matches and the prices come from one query each for the whole list, never one per product, and carry only what
// the list shows. The prices are the stored ones: viewing the list, filtered by a chip or not, asks no shop.
const [search, items, matchRead, priceRead] = await Promise.all([
  searchStep.kind === "search" ? searchRossmann(shopGateFor(supabase), searchStep.query, SEARCH_SIZE) : null,
  supabase ? listWatchlist(supabase) : null,
  supabase ? listMatchStates(supabase) : null,
  supabase ? listLatestPrices(supabase) : null,
]);

const unavailableMessage =
  search?.kind === "unavailable" ? shopUnavailableText(SHOP_LABELS.rossmann.name, search.reason, search.until) : null;

// Each product's row, judged now: a product whose price or decision in a matched shop couldn't be read says so.
const rows = items === null ? null : listRowsOf(items, matchRead, priceRead, Date.now());
// The chips, and the filter they set, only when every read worked and the list has products (listChipsOf).
const { counts, filter } = listChipsOf(rows, matchRead !== null && priceRead !== null, params.get("f"));

// "Dodaj"'s notice that the product is already on the list, what a removal came to, or that the password a handed-over
// link let the user set is saved, and an error's text, "Dodaj"'s or a sign-out's that didn't go through, in the list's
// own words (notices.ts): a code the app didn't send shows nothing.
const notice = params.has(EXISTS_PARAM)
  ? EXISTS_NOTICE
  : (removedNotice(params.get(REMOVED_PARAM)) ?? (params.has(PASSWORD_SET_PARAM) ? PASSWORD_SET_NOTICE : null));
const error = watchlistErrorMessage(params.get(ERROR_PARAM)) ?? signOutErrorMessage(params.get(SIGN_OUT_PARAM));
// "Moja lista", the page's heading, which names the rows' list too.
const LIST_HEADING_ID = "list-heading";
---

<WatchlistShell title="Moja lista · Drogeria Radar" mode="list" email={user?.email ?? null} query={rawQuery}>
  <ListHead
    slot="head"
    headingId={LIST_HEADING_ID}
    count={items?.length ?? null}
    path={Astro.url.pathname}
    filter={filter}
    counts={counts}
    refreshCode={parsePriceRefreshCode(params.get(LIST_PRICES_PARAM))}
  >
    {notice && (
      <Alert variant="success" role="status">
        <AlertDescription>{notice}</AlertDescription>
      </Alert>
    )}
    {error && (
      <Alert variant="destructive">
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}
    <SearchForm slot="search" id="q-mobile" value={rawQuery} variant="list" class="lg:hidden" />
  </ListHead>

  {rawQuery === null ? (
    <p class="hidden h-full items-center justify-center text-center text-muted-foreground lg:flex">
      Wybierz produkt z listy albo wyszukaj nowy.
    </p>
  ) : (
    <div class="flex flex-col gap-4 pt-4 lg:pt-0">
      {searchStep.kind === "invalid" && (
        <Alert variant="destructive">
          <AlertDescription>
            Wpisz od 2 do 80 znaków: litery, cyfry, spacje i znaki . , % &amp; ' + / ( ) -
          </AlertDescription>
        </Alert>
      )}
      {searchStep.kind === "filled" && (
        <Alert role="status">
          <AlertDescription>Naciśnij „Szukaj”, aby wyszukać „{searchStep.query}”.</AlertDescription>
        </Alert>
      )}
      {unavailableMessage && (
        <Alert variant="warning">
          <AlertDescription>{unavailableMessage}</AlertDescription>
        </Alert>
      )}
      {search?.kind === "results" && query !== null && (
        <SearchResults
          query={query}
          candidates={search.candidates}
          spellingHint={search.spellingHint}
          listed={items ?? []}
          path="/watchlist"
        />
      )}
    </div>
  )}
  <SubmitOnce />

  <ListRows
    slot="rows"
    rows={rows}
    filter={filter}
    matchesFailed={matchRead === null}
    pricesFailed={priceRead === null}
    labelledBy={LIST_HEADING_ID}
  />
  {counts !== null && <ListFooter slot="footer" />}
  <script>
    // The parameters are the ones the frontmatter reads its notices by, from a module that imports nothing server-only,
    // so this script ships no server code.
    import { LIST_NOTICE_PARAMS, withoutNotices } from "@/lib/notices";

    // A notice shows once: the address bar forgets the parameter that brought it, "Dodaj"'s (exists), an error's, the
    // list's refresh's (list-prices), a removal's (removed), a failed sign-out's (sign-out) or a saved password's
    // (password-set), so a reload or a copied link doesn't show it again. Every other parameter, the list's filter and
    // the search among them, and the hash stay (withoutNotices).
    const forgotten = withoutNotices(window.location.href, LIST_NOTICE_PARAMS);
    if (forgotten !== null) {
      history.replaceState(history.state, "", forgotten);
    }
  </script>
</WatchlistShell>
