---
// The page where the person a handed-over link just signed in chooses their password: one field and "Zapisz hasło", a
// plain form posted to /api/auth/set-password, which lands on the list with "Hasło zapisane." (SetPasswordView). Only a
// session a link opened within the last 60 minutes may see it: any other, a password sign-in's included, goes to the
// list (setPasswordRedirectOf), so the page never becomes a way to change a signed-in user's password; the middleware
// sends a visitor to sign-in. It shows a refused password's error in its own words: a code the app didn't send shows
// nothing (notices.ts). It asks no shop.
import SetPasswordView from "@/components/auth/SetPasswordView.astro";
import AuthShell from "@/layouts/AuthShell.astro";
import { ERROR_PARAM, passwordErrorMessage } from "@/lib/notices";
import { setPasswordRedirectOf } from "@/lib/services/auth";

const redirect = await setPasswordRedirectOf(Astro.locals.supabase, Date.now());
if (redirect !== null) {
  return Astro.redirect(redirect);
}
const error = passwordErrorMessage(Astro.url.searchParams.get(ERROR_PARAM));
---

<AuthShell title="Nowe hasło">
  <SetPasswordView error={error} />
  <script>
    // The parameters are the ones the frontmatter reads its notice by, from a module that imports nothing server-only,
    // so this script ships no server code.
    import { SET_PASSWORD_NOTICE_PARAMS, withoutNotices } from "@/lib/notices";

    // A notice shows once: the address bar forgets a refused password's error, so a reload or a copied link shows the
    // plain form (withoutNotices).
    const forgotten = withoutNotices(window.location.href, SET_PASSWORD_NOTICE_PARAMS);
    if (forgotten !== null) {
      history.replaceState(history.state, "", forgotten);
    }
  </script>
</AuthShell>
