---
// The frame of the watchlist's two screens, the list (/watchlist) and a product's page, on the paper. From lg (1024 px)
// up it's one screen: the header on top, then the list in a 420 px column on the left, its head, its rows scrolling on
// their own and its footer, beside the main pane, which scrolls on its own. Below lg it's a phone's screen, scrolling
// as a whole: on the list, its head, then the main pane, so a search's results sit above the rows, then the rows and
// the footer; on a product's page, only the main pane. The parts come in the `head`, `rows` and `footer` slots and the
// default one, the main pane's. A product's page without the list's parts gets the main pane alone, at full width.
// The frame keeps its content clear of a phone's notch and rounded corners, which viewport-fit=cover lets the page
// reach.
import AppHeader from "@/components/shell/AppHeader.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title: string;
  /** The list's screen, or a product's page. */
  mode: "list" | "product";
  /** The signed-in user's email, for the header, or null. */
  email: string | null;
  /** The search text the page was opened with, for the header's search field, or null. */
  query?: string | null;
}

const { title, mode, email, query = null } = Astro.props;
const hasList = Astro.slots.has("head") || Astro.slots.has("rows") || Astro.slots.has("footer");

// The list's column from lg: 420 px wide, with a 1.5 px edge towards the main pane, beside the main pane. The one row
// of a product's page, and the rows track of the list's, is bounded by the screen's height, so their parts scroll.
const COLUMNS = "lg:grid-cols-[calc(var(--spacing)*105)_minmax(0,1fr)]";
const EDGE = "lg:border-r-hairline";
// Each part's padding: an 18 px gutter on a phone, and the handoff's paddings from lg.
const HEAD = "flex flex-col px-4.5 pt-5.5 lg:px-7 lg:pt-7 lg:pb-4";
// 10 px above the rows from lg, so the selected row's lift and focus outline aren't cut off where its scrolling starts.
const ROWS = "px-4.5 pt-3.5 pb-2 lg:min-h-0 lg:overflow-y-auto lg:px-7 lg:pt-2.5 lg:pb-4.5";
// A page passes its footer only when it has one to show, and a slot passed conditionally still counts as given, so
// the footer's bar hides itself when nothing rendered in it.
const FOOTER = "px-5 pt-1.5 pb-6 empty:hidden lg:border-t-hairline lg:px-7 lg:py-3.5";
const MAIN = "px-4.5 lg:min-h-0 lg:overflow-y-auto lg:px-11 lg:pt-7.5 lg:pb-10";
---

<Layout title={title} lang="pl" theme="user">
  <div class="flex min-h-dvh flex-col bg-paper pt-[env(safe-area-inset-top)] pr-[env(safe-area-inset-right)] pb-[env(safe-area-inset-bottom)] pl-[env(safe-area-inset-left)] text-foreground lg:h-dvh">
    <AppHeader mode={mode} email={email} query={query} />
    {mode === "list" ? (
      <main class:list={["flex flex-1 flex-col lg:grid lg:min-h-0 lg:grid-rows-[auto_minmax(0,1fr)_auto]", COLUMNS]}>
        <div class:list={[HEAD, EDGE, "lg:col-start-1 lg:row-start-1"]}>
          <slot name="head" />
        </div>
        <div class:list={[MAIN, "lg:col-start-2 lg:row-span-3 lg:row-start-1"]}>
          <slot />
        </div>
        <div class:list={[ROWS, EDGE, "lg:col-start-1 lg:row-start-2"]}>
          <slot name="rows" />
        </div>
        <div class:list={[FOOTER, EDGE, "lg:col-start-1 lg:row-start-3"]}>
          <slot name="footer" />
        </div>
      </main>
    ) : (
      <div
        class:list={["flex flex-1 flex-col lg:min-h-0", hasList && ["lg:grid lg:grid-rows-[minmax(0,1fr)]", COLUMNS]]}
      >
        {hasList && (
          <aside aria-label="Moja lista" class:list={["hidden lg:flex lg:min-h-0 lg:flex-col", EDGE]}>
            <div class:list={HEAD}>
              <slot name="head" />
            </div>
            <div class:list={[ROWS, "lg:flex-1"]}>
              <slot name="rows" />
            </div>
            <div class:list={FOOTER}>
              <slot name="footer" />
            </div>
          </aside>
        )}
        <main class:list={[MAIN, "flex-1"]}>
          <slot />
        </main>
      </div>
    )}
  </div>
</Layout>
