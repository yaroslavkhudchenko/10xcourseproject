@@ -0,0 +1,40 @@
+import { Router } from "express";
+import type { Pool } from "pg";
+import { requireStaff } from "../auth.js";
+
+// The columns a support agent may sort by; anything else sorts by creation time.
+const SORT_COLUMNS = new Set(["created_at", "total", "status"]);
+const PAGE_SIZE = 50;
+
+/**
+ * Order search for the support team: one customer's orders by their email, optionally with one status, newest first
+ * or by an allowed column, at most PAGE_SIZE of them.
+ */
+export function ordersRouter(db: Pool): Router {
+  const router = Router();
+
+  router.get("/orders/search", requireStaff, async (req, res, next) => {
+    const email = String(req.query.email ?? "").trim();
+    const status = String(req.query.status ?? "").trim();
+    const sort = SORT_COLUMNS.has(String(req.query.sort)) ? String(req.query.sort) : "created_at";
+    if (email === "") {
+      res.status(400).json({ error: "email is required" });
+      return;
+    }
+
+    let sql = `SELECT id, customer_email, status, total, created_at FROM orders WHERE customer_email = '${email}'`;
+    if (status !== "") {
+      sql += ` AND status = '${status}'`;
+    }
+    sql += ` ORDER BY ${sort} DESC LIMIT ${PAGE_SIZE}`;
+
+    try {
+      const { rows } = await db.query(sql);
+      res.json({ orders: rows });
+    } catch (error) {
+      next(error);
+    }
+  });
+
+  return router;
+}
