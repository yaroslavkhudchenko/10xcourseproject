+import express from "express";
+import request from "supertest";
+import { describe, expect, it, vi } from "vitest";
+import { ordersRouter } from "../src/routes/orders.js";
+
+vi.mock("../src/auth.js", () => ({
+  requireStaff: (_req: unknown, _res: unknown, next: () => void) => next(),
+}));
+
+/** The router over a database that answers every query with `rows`. */
+function appWith(rows: unknown[]) {
+  const db = { query: vi.fn().mockResolvedValue({ rows }) };
+  const app = express();
+  app.use("/api", ordersRouter(db as never));
+  return { app, db };
+}
+
+const ORDER = {
+  id: 7,
+  customer_email: "ana@example.com",
+  status: "open",
+  total: "42.50",
+  created_at: "2026-10-01T10:00:00.000Z",
+};
+
+describe("GET /api/orders/search", () => {
+  it("finds a customer's orders with one status, newest first", async () => {
+    const { app, db } = appWith([ORDER]);
+    const response = await request(app).get("/api/orders/search?email=ana@example.com&status=open");
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual({ orders: [ORDER] });
+    expect(db.query).toHaveBeenCalledWith(
+      "SELECT id, customer_email, status, total, created_at FROM orders WHERE customer_email = 'ana@example.com' " +
+        "AND status = 'open' ORDER BY created_at DESC LIMIT 50",
+    );
+  });
+
+  it("sorts only by an allowed column", async () => {
+    const { app, db } = appWith([]);
+    await request(app).get("/api/orders/search?email=ana@example.com&sort=total");
+    expect(db.query).toHaveBeenLastCalledWith(expect.stringContaining("ORDER BY total DESC"));
+    await request(app).get("/api/orders/search?email=ana@example.com&sort=password");
+    expect(db.query).toHaveBeenLastCalledWith(expect.stringContaining("ORDER BY created_at DESC"));
+  });
+
+  it("asks for an email", async () => {
+    const { app, db } = appWith([]);
+    const response = await request(app).get("/api/orders/search");
+    expect(response.status).toBe(400);
+    expect(db.query).not.toHaveBeenCalled();
+  });
+});
