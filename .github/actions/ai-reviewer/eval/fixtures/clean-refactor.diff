diff --git a/src/lib/services/shops/shop-values.test.ts b/src/lib/services/shops/shop-values.test.ts
new file mode 100644
index 0000000..1ba1d4c
--- /dev/null
+++ b/src/lib/services/shops/shop-values.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { cleanText, textOf } from "@/lib/services/shops/shop-values";
+
+describe("cleanText", () => {
+  it.each([
+    { form: "a trailing space, as Rossmann sends the name „Soft ”", text: "Soft ", cleaned: "Soft" },
+    { form: "spaces and a line break around it", text: "  300 ml\n", cleaned: "300 ml" },
+    { form: "nothing to trim", text: "NIVEA", cleaned: "NIVEA" },
+  ])("trims text with $form", ({ text, cleaned }) => {
+    expect(cleanText(text)).toBe(cleaned);
+  });
+
+  it.each([
+    { why: "empty text", value: "" },
+    { why: "only spaces", value: "   " },
+    { why: "null", value: null },
+    { why: "a field left out", value: undefined },
+  ])("reads $why as none", ({ value }) => {
+    expect(cleanText(value)).toBeNull();
+  });
+});
+
+describe("textOf", () => {
+  it("reads an attribute's first value, trimmed, from a list or a single value", () => {
+    expect(textOf([" Nivea ", "Other"])).toBe("Nivea");
+    expect(textOf("Nivea Soft")).toBe("Nivea Soft");
+  });
+
+  it.each<{ why: string; attribute: unknown }>([
+    { why: "an empty list", attribute: [] },
+    { why: "blank text", attribute: [" "] },
+    { why: "a number", attribute: [300] },
+    { why: "null", attribute: null },
+  ])("reads nothing from $why", ({ attribute }) => {
+    expect(textOf(attribute)).toBeNull();
+  });
+});
