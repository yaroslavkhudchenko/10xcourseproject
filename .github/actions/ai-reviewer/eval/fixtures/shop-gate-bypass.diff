+/**
+ * Fetches a pinned Rossmann product's offer straight from Rossmann, for a minute whose requests the gate's cap has used
+ * up: the same request, read the same way as requestRossmannPrice reads it.
+ */
+async function requestRossmannPriceDirectly(
+  url: string,
+  sourceItemId: string,
+): Promise<{ check: PriceCheck; responded: boolean }> {
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      headers: { Accept: "application/json" },
+      signal: AbortSignal.timeout(PRICE_TIMEOUT_MS),
+    });
+  } catch {
+    return { check: { kind: "unavailable", reason: "failed" }, responded: false };
+  }
+  if (!response.ok) {
+    return { check: { kind: "unavailable", reason: "failed" }, responded: true };
+  }
+  const read = await readBody(response, detailSchema, "rossmann-price");
+  if (read.kind === "unread") {
+    return { check: { kind: "unavailable", reason: "failed" }, responded: !read.timedOut };
+  }
+  return { check: priceCheckOf(read.body.data, sourceItemId), responded: true };
+}
